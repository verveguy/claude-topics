#!/usr/bin/env bash
# topics-list: fzf topic picker, run in the left pane of topics-ui.
# Topics are grouped by working directory. Selecting one points the right pane at
# that topic's tmux session.
#
#   topics-list          the picker
#   topics-list --rows   the grouped rows it feeds fzf (also its ctrl-r reload)
UI="tmux -L topics-ui"

# This pane runs inside the UI's own tmux server, so $TMUX points there. topic must
# talk to the default server, where the topic sessions live.
unset TMUX

rows() {
  # Row: STATUS<TAB>NAME. A group header has an empty STATUS and is not selectable.
  topic list 2>/dev/null | python3 -I -c '
import sys, os, json
home = os.path.expanduser("~")
cfg = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(home, ".claude")
dirs = {}
for d in os.listdir(os.path.join(cfg, "topics")):
    try:
        t = json.load(open(os.path.join(cfg, "topics", d, "topic.json")))
        dirs[t["name"]] = t.get("dir") or ""
    except (OSError, ValueError, KeyError):
        pass
groups = {}
for line in sys.stdin:
    f = line.split(None, 1)
    if len(f) == 2 and f[0] in ("UP", "down", "ADOPTED"):
        name = f[1].strip()
        d = dirs.get(name, "")
        if d.startswith(home + "/dev/"):
            d = d[len(home) + 5:]
        elif d.startswith(home):
            d = "~" + d[len(home):]
        groups.setdefault(d or "(no directory)", []).append((f[0], name))
for d in sorted(groups):
    print("\t-- %s" % d)
    for s, n in sorted(groups[d], key=lambda x: x[1].lower()):
        print("%s\t%s" % (s, n))
'
}

if [ "${1:-}" = "--rows" ]; then rows; exit; fi

SELF="$0"
while true; do
  row=$(rows \
    | fzf --delimiter='\t' --with-nth=1,2 --no-sort --reverse \
          --header='enter: open  ^r: refresh' \
          --bind="ctrl-r:reload($(printf '%q' "$SELF") --rows)")
  [ -z "$row" ] && continue
  status=${row%%$'\t'*}
  name=${row#*$'\t'}
  [ -z "$status" ] && continue   # a group header

  case "$status" in
    ADOPTED)
      $UI display-message "\"$name\" is still running outside tmux: exit it, then topic up"
      continue ;;
    down)
      $UI display-message "picking up \"$name\"..."
      topic up "$name" >/dev/null 2>&1 ;;
  esac

  RIGHT=$($UI show -gv @right-pane)
  $UI respawn-pane -k -t "$RIGHT" "$(printf 'env -u TMUX tmux attach -t %q' "$name")"
  $UI select-pane -t "$RIGHT"
done
