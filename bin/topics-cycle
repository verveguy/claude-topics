#!/usr/bin/env bash
# topics-cycle — take every profile's topics down cleanly, and bring them back.
#
#   topics-cycle down [--dry-run]   Unload the launchd agents, then put every live
#                                   topic down in every installed profile.
#   topics-cycle up   [--dry-run]   Reload the agents, then start each profile's
#                                   Dispatcher.
#   topics-cycle profiles           List the profiles this would act on.
#
# Why two commands rather than one: the point of taking everything down is usually to
# do something in between — log a profile in or out, rotate credentials, upgrade
# Claude Code. Run `down`, do that, then run `up`.
#
# ORDER MATTERS, and this is the whole reason the script exists:
#   1. The launchd agents run `topic ensure-dispatcher` every 5 minutes. Putting a
#      Dispatcher down without unloading its agent first means launchd restarts it
#      underneath you, mid-login.
#   2. Putting topics down is LOSSLESS — each keeps its session UUID and `topic up`
#      is a real --resume. Nothing here destroys work.
#   3. The topic running this script is skipped: putting it down kills the script.
#      It is named at the end so you can take it down last, by hand.
set -euo pipefail

LAUNCH_AGENTS="$HOME/Library/LaunchAgents"
PLIST_GLOB="$LAUNCH_AGENTS/com.verveguy.claude-dispatcher*.plist"

command -v topic >/dev/null || { echo "topics-cycle: topic not found on PATH" >&2; exit 1; }

DRY=0
CMD="${1:-}"; shift || true
for a in "$@"; do
  case "$a" in
    --dry-run) DRY=1 ;;
    *) echo "topics-cycle: unknown option: $a" >&2; exit 2 ;;
  esac
done

run() {  # run <description> <command...>
  if [[ $DRY -eq 1 ]]; then echo "  would: $*"; else "$@"; fi
}

# Every installed Dispatcher plist names the profile it manages, so the launchd
# agents ARE the registry of installed profiles — no second list to keep in sync.
# Emits: <plist-path> \t <config-dir>
profiles() {
  local p found=0
  for p in $PLIST_GLOB; do
    [[ -f "$p" ]] || continue
    found=1
    local dir
    dir="$(python3 -c '
import plistlib, sys
d = plistlib.load(open(sys.argv[1], "rb"))
print((d.get("EnvironmentVariables") or {}).get("CLAUDE_CONFIG_DIR", ""))' "$p")"
    [[ -n "$dir" ]] || dir="$HOME/.claude"   # pre-profile plist: default profile
    printf '%s\t%s\n' "$p" "$dir"
  done
  # No agents installed at all: still act on the profile in the environment.
  [[ $found -eq 1 ]] || printf '%s\t%s\n' "-" "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
}

case "$CMD" in
  profiles)
    while IFS=$'\t' read -r plist dir; do
      printf '  %-28s %s\n' "$(basename "${plist%.plist}")" "$dir"
    done < <(profiles)
    ;;

  down)
    echo "== 1. Unloading launchd agents (or they restart Dispatchers underneath you)"
    while IFS=$'\t' read -r plist dir; do
      [[ "$plist" == "-" ]] && { echo "  (no agents installed)"; continue; }
      run launchctl unload "$plist"
    done < <(profiles)

    echo
    echo "== 2. Putting topics down (lossless — every session stays resumable)"
    while IFS=$'\t' read -r plist dir; do
      echo "  -- profile: $dir"
      if [[ $DRY -eq 1 ]]; then
        CLAUDE_CONFIG_DIR="$dir" topic down-all --dry-run | sed 's/^/  /'
      else
        CLAUDE_CONFIG_DIR="$dir" topic down-all | sed 's/^/  /'
      fi
    done < <(profiles)

    echo
    echo "Next: log each profile in from a plain session in your home directory,"
    echo "then run:  topics-cycle up"
    ;;

  up)
    echo "== 1. Reloading launchd agents"
    while IFS=$'\t' read -r plist dir; do
      [[ "$plist" == "-" ]] && { echo "  (no agents installed)"; continue; }
      run launchctl load -w "$plist"
    done < <(profiles)

    echo
    echo "== 2. Starting each profile's Dispatcher"
    while IFS=$'\t' read -r plist dir; do
      echo "  -- profile: $dir"
      if [[ $DRY -eq 1 ]]; then
        echo "    would: CLAUDE_CONFIG_DIR=$dir topic ensure-dispatcher"
      else
        CLAUDE_CONFIG_DIR="$dir" topic ensure-dispatcher | sed 's/^/    /'
      fi
    done < <(profiles)

    echo
    echo "Other topics stay down until you pick them up:  topic up \"<name>\""
    echo '(they are unchanged — up resumes the same session)'
    ;;

  *)
    sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'
    exit 2
    ;;
esac
