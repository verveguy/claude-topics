#!/usr/bin/env bash
# topic — pick up / put down / hand off long-running Claude Code "topics".
#
# A TOPIC is a stable name ("Fantasy Economics") that outlives any single Claude
# session. The session underneath gets recycled; the topic name does not. That is
# what makes hand-off possible.
#
#   topic up   "<name>" [dir]   Pick up: resume the topic's session, or start one.
#                               --seed-from <file> starts a NEW topic from a brief.
#   topic down "<name>"         Put down: terminate the session, stay resumable.
#   topic down-all              Put every live topic in this profile down. Skips the
#                               calling session unless --include-self. --dry-run.
#   topic list [--all]          Show every topic and whether it is up or down.
#                               --all crosses every profile on the machine.
#   topic status "<name>"       Detail for one topic.
#   topic forget "<name>"       Stop tracking a topic (keeps handoff docs; --purge
#                               removes them). The session itself is untouched.
#   topic prune                 Show topics that are truly dead — down, with no
#                               transcript left to resume. --yes removes them.
#   topic adopt "<name>"        Track a session topic did not launch — live (via
#                               ~/.claude/sessions/<pid>.json) or merely resumable
#                               (via its transcript title). --pid / --dir / --title
#                               disambiguate; --probe <token> handles a running but
#                               unnamed session.
#
#   topic handoff-path "<name>" Print where the handoff doc must be written.
#   topic handoff-swap "<name>" Retire the old session, start a fresh one seeded
#                               with the handoff doc, same topic name.
#
#   topic fork-path "<new>"     Print where the fork brief must be written.
#   topic fork "<new>" [dir]    Split a thread into its own topic, seeded with that
#                               brief. --from "<parent>" defaults to the calling
#                               topic; the directory defaults to the parent's.
#   topic whoami                Name the topic the caller is sitting in.
#
#   topic profiles              Every Claude Code profile, and its topic count.
#   topic move "<name>" --to <profile>
#                               (--carry-approvals copies your trust / external-import
#                               answers for its directory into the destination.)
#                               Move a topic — registry, docs, and transcripts — into
#                               another profile. A live topic is put down and brought
#                               back up on the far side (--stay-down to leave it down).
#                               --copy leaves the original, --dry-run shows the plan.
#
#   topic rename "<old>" "<new>"
#                               Rename a topic everywhere: registry, tmux, peer name,
#                               Claude UI name, and transcript title.
#   topic rebridge "<name>"|--all [--down-only]
#                               Drop a session's recorded Remote Control bridge so the
#                               next launch registers a fresh one — under the current
#                               profile's account, named after the topic.
#
#   topic ensure-dispatcher     Start the Dispatcher topic if it is not up.
#                               (Run by launchd at login and every 5 minutes.)
#
# Each topic is backed by a stable session UUID, so `up` is a lossless --resume.
# Every session is started with BOTH --remote-control "<name>" and --name "<name>".
# Both are required and they do different jobs:
#   --remote-control  makes the session reachable from claude.ai / your phone
#   --name            sets the display name other Claude sessions see in
#                     ListAgents (without it a local session advertises itself
#                     as an auto-derived "<dir>-<hash>" and is unaddressable
#                     by topic name — verified 2026-08-08)
#
# Singleton: at most one live session per topic, enforced by an exact-match tmux
# check plus an atomic lock. Starting a topic that is already up is a no-op.
#
# PROFILES: honours CLAUDE_CONFIG_DIR, exactly as `claude` does. Every path — the
# topic registry, session records, transcripts — comes from it, sessions are launched
# with it, and non-default profiles get their tmux sessions namespaced so two
# profiles cannot fight over one topic name. Set it per shell to manage a profile:
#   CLAUDE_CONFIG_DIR=~/.claude-work topic list
set -euo pipefail

# Which Claude Code profile are we managing? Claude Code reads CLAUDE_CONFIG_DIR, so
# honour exactly the same variable: `topic` must look at the same sessions,
# transcripts and registry as the `claude` it is driving. Everything below derives
# from this — nothing hardcodes ~/.claude.
CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"

TOPICS_ROOT="${CLAUDE_TOPICS_ROOT:-$CLAUDE_DIR/topics}"

# Short label for a profile: ~/.claude-v3rv -> "v3rv", the default profile -> "".
# Takes the profile as an argument so cross-profile commands can compute it for a
# profile other than the active one.
profile_tag_of() {
  [[ "$1" == "$HOME/.claude" ]] && { printf ''; return 0; }
  basename "$1" | sed 's/^\.//; s/^claude-//'
}
PROFILE_TAG="$(profile_tag_of "$CLAUDE_DIR")"

# Every Claude Code profile on this machine: the default, plus ~/.claude-* that
# actually look like config dirs (a stray ~/.claude-backup should not count).
list_profiles() {
  printf '%s\n' "$HOME/.claude"
  local d
  for d in "$HOME"/.claude-*; do
    [[ -d "$d" ]] || continue
    [[ -d "$d/projects" || -f "$d/.claude.json" ]] || continue
    printf '%s\n' "$d"
  done
}

# "v3rv" -> ~/.claude-v3rv, "default" -> ~/.claude, an absolute path -> itself.
resolve_profile() {
  case "${1:-}" in
    "")        printf '%s/.claude' "$HOME" ;;
    default)   printf '%s/.claude' "$HOME" ;;
    /*)        printf '%s' "${1%/}" ;;
    *)         printf '%s/.claude-%s' "$HOME" "$1" ;;
  esac
}

# Each profile runs its own Dispatcher, so their names must differ — otherwise they
# collide as topic names, as Remote Control names in ListAgents, and in the tmux
# window list. The default profile keeps the bare "Dispatcher" it already has.
if [[ -n "$PROFILE_TAG" ]]; then
  DISPATCHER_NAME="${CLAUDE_DISPATCHER_NAME:-Dispatcher ($PROFILE_TAG)}"
else
  DISPATCHER_NAME="${CLAUDE_DISPATCHER_NAME:-Dispatcher}"
fi

# tmux is machine-global, not per-profile: two profiles each running a topic called
# "Fantasy Images" would fight over one tmux session, and `topic up` would report the
# other profile's session as already up. So namespace non-default profiles. The
# default profile keeps bare names, so existing sessions and the documented
# `tmux attach -t "<topic>"` keep working unchanged.
#   ~/.claude        -> ""          "Fantasy Images"
#   ~/.claude-v3rv   -> "v3rv/"     "v3rv/Fantasy Images"
TMUX_PREFIX=""
[[ -n "$PROFILE_TAG" ]] && TMUX_PREFIX="$PROFILE_TAG/"

# launchd gives us a minimal PATH; make sure the tools we need are findable.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

die() { echo "topic: $*" >&2; exit 1; }

command -v tmux   >/dev/null || die "tmux not found on PATH"
command -v claude >/dev/null || die "claude not found on PATH"
command -v python3 >/dev/null || die "python3 not found on PATH"

# ---------------------------------------------------------------- names & paths

# "Fantasy Economics" -> "fantasy-economics" (registry directory name)
slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'
}

# tmux forbids ':' and '.' in session names; the display name keeps them. Non-default
# profiles are prefixed so their topics cannot collide with the default profile's.
tmux_name() { tmux_name_in "$PROFILE_TAG" "$1"; }

# tmux_name_in <profile-tag> <display-name> — the same mapping for any profile.
tmux_name_in() {
  local pre=""; [[ -n "$1" ]] && pre="$1/"
  printf '%s%s' "$pre" "$(printf '%s' "$2" | tr ':.' '--')"
}

topic_dir()  { printf '%s/%s' "$TOPICS_ROOT" "$(slugify "$1")"; }
topic_json() { printf '%s/topic.json' "$(topic_dir "$1")"; }

# ---------------------------------------------------------------- registry (JSON)

reg_read() {  # reg_read <name> <key> -> value or ""
  local f; f="$(topic_json "$1")"
  [[ -f "$f" ]] || { printf ''; return 0; }
  python3 -c '
import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: d={}
v=d.get(sys.argv[2],"")
print(v if v is not None else "")' "$f" "$2"
}

reg_read_at() {  # reg_read_at <topic.json path> <key> -> value or ""
  [[ -f "$1" ]] || { printf ''; return 0; }
  python3 -c '
import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: d={}
v=d.get(sys.argv[2],"")
print(v if v is not None else "")' "$1" "$2"
}

reg_write() {  # reg_write <name> <k> <v> [<k> <v> ...]
  local name="$1"; shift
  local f; f="$(topic_json "$name")"
  mkdir -p "$(dirname "$f")"
  python3 -c '
import json,os,sys
f=sys.argv[1]
try: d=json.load(open(f))
except Exception: d={}
kv=sys.argv[2:]
for i in range(0,len(kv),2): d[kv[i]]=kv[i+1]
tmp=f+".tmp"
json.dump(d,open(tmp,"w"),indent=2)
os.replace(tmp,f)' "$f" "$@"
}

reg_push_history() {  # reg_push_history <name> <sessionId> <handoffDoc>
  local f; f="$(topic_json "$1")"
  python3 -c '
import json,os,sys,datetime
f,sid,doc=sys.argv[1],sys.argv[2],sys.argv[3]
try: d=json.load(open(f))
except Exception: d={}
d.setdefault("history",[]).append({
  "sessionId": sid, "handoffDoc": doc,
  "retiredAt": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
})
tmp=f+".tmp"; json.dump(d,open(tmp,"w"),indent=2); os.replace(tmp,f)' "$f" "$2" "$3"
}

reg_push_fork() {  # reg_push_fork <parent> <child>
  local f; f="$(topic_json "$1")"
  [[ -f "$f" ]] || return 0          # parent not registered: nothing to record on
  python3 -c '
import json,os,sys
f,child=sys.argv[1],sys.argv[2]
try: d=json.load(open(f))
except Exception: d={}
forks=d.setdefault("forks",[])
if child not in forks: forks.append(child)
tmp=f+".tmp"; json.dump(d,open(tmp,"w"),indent=2); os.replace(tmp,f)' "$f" "$2"
}

now_iso() { date +%Y-%m-%dT%H:%M:%S%z; }

# Where a profile's CONFIG lives — which is not simply "inside the profile dir".
# With CLAUDE_CONFIG_DIR unset, Claude Code reads ~/.claude.json; set it to
# ~/.claude and it reads ~/.claude/.claude.json instead. Same data directories
# (projects/, sessions/), different config file, and therefore different onboarding
# and account state. Verified 2026-08-09.
config_file_of() {
  if [[ "$1" == "$HOME/.claude" ]]; then printf '%s/.claude.json' "$HOME"
  else printf '%s/.claude.json' "$1"; fi
}

# A per-project flag from a profile's config, e.g. hasClaudeMdExternalIncludesApproved.
# These approvals are recorded per profile and do NOT travel with a moved topic.
project_flag() {  # project_flag <config-file> <work-dir> <key>
  [[ -f "$1" ]] || { printf ''; return 0; }
  python3 -c '
import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: print(""); sys.exit(0)
p=(d.get("projects") or {}).get(sys.argv[2]) or {}
v=p.get(sys.argv[3], "")
print("" if v is None else v)' "$1" "$2" "$3"
}

# Has this profile finished first-run setup? A profile that has not will open on the
# theme picker instead of a usable session.
profile_onboarded() {
  local f; f="$(config_file_of "$1")"
  [[ -f "$f" ]] || return 1
  python3 -c '
import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: sys.exit(1)
sys.exit(0 if d.get("hasCompletedOnboarding") else 1)' "$f"
}

# Wait until a file stops changing (size + mtime steady twice in a row), up to ~5s.
# A Claude session that has just been asked to exit keeps writing for a moment.
settle() {
  local f="$1" last="" cur="" stable=0 i
  [[ -e "$f" ]] || return 0
  for i in $(seq 1 25); do
    cur="$(stat -f '%z-%m' "$f" 2>/dev/null || echo gone)"
    if [[ "$cur" == "$last" ]]; then
      stable=$((stable + 1))
      [[ $stable -ge 2 ]] && return 0
    else
      stable=0
    fi
    last="$cur"
    sleep 0.2
  done
  return 0
}

# ---------------------------------------------------------------- liveness

is_up() { tmux has-session -t "=$(tmux_name "$1")" 2>/dev/null; }

# Atomic per-topic lock so two callers can't race a topic up at once.
lock_acquire() {
  local d="$TOPICS_ROOT/.locks"; mkdir -p "$d"
  LOCK_PATH="$d/$(slugify "$1").lock"
  if ! mkdir "$LOCK_PATH" 2>/dev/null; then
    # Stale lock older than 5 minutes is reclaimed.
    if [[ -n "$(find "$LOCK_PATH" -maxdepth 0 -mmin +5 2>/dev/null)" ]]; then
      rmdir "$LOCK_PATH" 2>/dev/null || true
      mkdir "$LOCK_PATH" 2>/dev/null || die "could not acquire lock for \"$1\""
    else
      die "\"$1\" is being started by another process (lock held)"
    fi
  fi
  trap 'rmdir "$LOCK_PATH" 2>/dev/null || true' EXIT
}

# ---------------------------------------------------------------- launching

# launch_session <display-name> <dir> <claude-args...>
# Creates a detached tmux session and sends the claude command into it.
# send-keys (not `tmux new -d claude`) so the shell survives claude exiting.
launch_session() {
  local name="$1" dir="$2"; shift 2
  local tn; tn="$(tmux_name "$name")"

  mkdir -p "$dir"; dir="$(cd "$dir" && pwd)"

  # Pin the profile onto the command itself. A detached tmux session does NOT
  # reliably inherit our environment — the tmux server may long predate us — and a
  # session launched under the wrong profile writes its transcript somewhere this
  # `topic` cannot see, breaking adopt/prune/resume in confusing ways.
  #
  # But ONLY for non-default profiles. CLAUDE_CONFIG_DIR=~/.claude is NOT the same as
  # leaving it unset: unset reads ~/.claude.json, set reads ~/.claude/.claude.json —
  # a different file that has never completed onboarding, so the session comes up at
  # the first-run theme picker and hangs. The default profile must stay unset.
  local cmd="claude"
  [[ -n "$PROFILE_TAG" ]] &&
    cmd="CLAUDE_CONFIG_DIR=$(printf '%q' "$CLAUDE_DIR") claude"
  local a; for a in "$@"; do cmd+=" $(printf '%q' "$a")"; done

  tmux new-session -d -s "$tn" -c "$dir"
  tmux send-keys -t "$tn" "$cmd" Enter

  # Auto-accept the workspace trust prompt if it appears; otherwise wait for a
  # readiness marker. NOTE: this heuristic keys on Claude Code's startup text and
  # has needed updating before — suspect it first if startup detection misbehaves.
  printf "  starting"
  local i pane trusted=0
  for i in $(seq 1 40); do
    pane="$(tmux capture-pane -t "$tn" -p 2>/dev/null || true)"
    # Accept the workspace trust prompt, then KEEP POLLING. Breaking out here was a
    # bug: further prompts can follow it (the external-imports one below), and the
    # session would be reported up while still sitting on an unanswered question.
    if [[ $trusted -eq 0 ]] && printf '%s' "$pane" | grep -q "trust this folder"; then
      sleep 0.3; tmux send-keys -t "$tn" Enter; printf " (trust accepted)"; trusted=1
      continue
    fi
    # A security question topic will NOT answer for the user. Seen the first time a
    # profile opens a project whose CLAUDE.md imports from outside the working
    # directory.
    if printf '%s' "$pane" | grep -q "Allow external CLAUDE.md file imports"; then
      tmux kill-session -t "=$tn" 2>/dev/null || true
      echo >&2
      echo "topic: \"$name\" needs a one-off decision this profile has not made yet:" >&2
      echo "  \"Allow external CLAUDE.md file imports?\" — a security question about" >&2
      echo "  imports outside $dir, which topic will not answer for you." >&2
      echo "  Start it once by hand, answer it, then retry:" >&2
      if [[ -n "$PROFILE_TAG" ]]; then
        echo "    (cd $dir && CLAUDE_CONFIG_DIR=$CLAUDE_DIR claude)" >&2
      else
        echo "    (cd $dir && claude)" >&2
      fi
      die "unanswered startup prompt"
    fi
    if printf '%s' "$pane" | grep -qiE "Welcome back|remote-control is active"; then
      break
    fi
    # First-run setup: the theme picker or a login prompt. `topic` must not answer
    # these — picking a theme and choosing an account are the user's decisions — and
    # waiting is pointless, so fail fast rather than time out and leave a session
    # parked at a prompt that `is_up` would happily report as UP.
    if printf '%s' "$pane" | grep -qiE "colorblind-friendly|Select login method|Choose the text style"; then
      tmux kill-session -t "=$tn" 2>/dev/null || true
      echo >&2
      echo "topic: profile $CLAUDE_DIR has not completed first-run setup." >&2
      echo "  The session opened on the theme/login prompt, which topic will not answer" >&2
      echo "  for you. Run it once interactively, then retry:" >&2
      if [[ -n "$PROFILE_TAG" ]]; then
        echo "    CLAUDE_CONFIG_DIR=$CLAUDE_DIR claude" >&2
      else
        echo "    claude" >&2
      fi
      echo "  Its config file is $(config_file_of "$CLAUDE_DIR")" >&2
      die "profile not set up"
    fi
    sleep 0.5; printf "."
  done
  echo
}

# Gracefully stop the claude process in a topic's tmux session, then kill it.
stop_session() {
  local tn; tn="$(tmux_name "$1")"
  tmux has-session -t "=$tn" 2>/dev/null || return 0
  # Escape interrupts any in-flight turn; /exit quits Claude cleanly so the
  # transcript is flushed. Transcripts are written incrementally, so even a hard
  # kill stays resumable — this is just the tidy path.
  tmux send-keys -t "$tn" Escape 2>/dev/null || true
  sleep 0.4
  tmux send-keys -t "$tn" "/exit" Enter 2>/dev/null || true
  local i
  for i in $(seq 1 12); do
    tmux has-session -t "=$tn" 2>/dev/null || return 0
    if ! tmux list-panes -t "=$tn" -F '#{pane_current_command}' 2>/dev/null | grep -qi claude; then
      break
    fi
    sleep 0.5
  done
  tmux kill-session -t "=$tn" 2>/dev/null || true
}

new_uuid() { uuidgen | tr '[:upper:]' '[:lower:]'; }

# ---------------------------------------------------------------- commands

cmd_up() {
  local name="" dir="" claim=0 seed_from=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --claim) claim=1; shift ;;
      --seed-from) seed_from="$2"; shift 2 ;;
      *) if [[ -z "$name" ]]; then name="$1"; else dir="$1"; fi; shift ;;
    esac
  done
  [[ -n "$name" ]] || die "usage: topic up \"<name>\" [dir] [--claim] [--seed-from <file>]"
  if [[ -n "$seed_from" ]]; then
    [[ -f "$seed_from" ]] || die "--seed-from: no such file: $seed_from"
    [[ -s "$seed_from" ]] || die "--seed-from: file is empty: $seed_from"
    seed_from="$(cd "$(dirname "$seed_from")" && pwd)/$(basename "$seed_from")"
  fi

  lock_acquire "$name"

  # An adopted topic still has its ORIGINAL process running outside tmux. Starting
  # here would --resume the same session UUID in a second process: two writers on
  # one transcript, which corrupts it.
  #
  # When adoption went through ~/.claude/sessions we know the original pid, so the
  # hazard IS detectable — and --claim must not be allowed to override a process we
  # can still see. Match on sessionId too, in case the pid has been recycled.
  local adopted_pid=""
  if [[ "$(reg_read "$name" state)" == "adopted" ]]; then
    adopted_pid="$(reg_read "$name" adoptedPid)"
    if [[ -n "$adopted_pid" ]]; then
      local asid live
      asid="$(reg_read "$name" sessionId)"
      live="$(live_sessions || true)"
      if [[ "$live" == *"$adopted_pid	$asid	"* ]]; then
        echo "\"$name\" is still running as pid $adopted_pid, outside tmux." >&2
        echo "  Resuming session ${asid:0:8}… in a second process would corrupt its" >&2
        echo "  transcript. Exit that session (/exit in its window), then re-run." >&2
        die "refusing to start while the original process is alive"
      fi
      # Positively verified gone — no need to make the caller assert it.
      claim=1
    fi
  fi

  # No pid on record (probe-adopted, or an older registry entry): we cannot see the
  # original process, so make the caller assert it is gone.
  if [[ "$(reg_read "$name" state)" == "adopted" && $claim -eq 0 ]]; then
    echo "\"$name\" was adopted but not yet claimed." >&2
    echo "" >&2
    echo "  Its original session is running OUTSIDE tmux. Starting it here would" >&2
    echo "  resume the same session UUID in a second process and corrupt the" >&2
    echo "  transcript." >&2
    echo "" >&2
    echo "  1. Exit the original session (/exit in its window)." >&2
    echo "  2. topic up \"$name\" --claim" >&2
    die "refusing to start until the original session has exited"
  fi

  if is_up "$name"; then
    echo "\"$name\" is already up."
    echo "  attach: tmux attach -t \"$(tmux_name "$name")\""
    return 0
  fi

  local recorded_dir sid
  recorded_dir="$(reg_read "$name" dir)"
  [[ -z "$dir" ]] && dir="${recorded_dir:-$PWD}"
  sid="$(reg_read "$name" sessionId)"

  if [[ -n "$sid" ]]; then
    [[ -n "$seed_from" ]] &&
      echo "note: --seed-from ignored; \"$name\" has an existing session to resume." >&2
    echo "Picking up \"$name\" (resuming session ${sid:0:8}…) in $dir"
    launch_session "$name" "$dir" --remote-control "$name" --name "$name" --resume "$sid"
  else
    sid="$(new_uuid)"
    echo "Starting \"$name\" (new session ${sid:0:8}…) in $dir"
    if [[ -n "$seed_from" ]]; then
      # Same seeding path handoff-swap uses, but for a brand-new topic: start a
      # topic from a brief (a handoff doc, an ideas/ note, an issue write-up).
      local seed="You are starting the topic \"$name\". Read the briefing document at $seed_from — it contains the context you need. Summarise briefly what you picked up, then continue from there."
      launch_session "$name" "$dir" --remote-control "$name" --name "$name" \
                     --session-id "$sid" "$seed"
      reg_write "$name" name "$name" generation "1" seededFrom "$seed_from"
    else
      launch_session "$name" "$dir" --remote-control "$name" --name "$name" --session-id "$sid"
      reg_write "$name" name "$name" generation "1"
    fi
  fi

  reg_write "$name" name "$name" dir "$dir" sessionId "$sid" \
            state "up" lastPickedUp "$(now_iso)"
  echo "\"$name\" is up. Remote Control name: \"$name\""
}

cmd_down() {
  local name="${1:?usage: topic down \"<name>\"}"
  if ! is_up "$name"; then
    # An adopted session runs outside tmux, so we cannot stop it for the user.
    # Say so plainly rather than reporting a false "already down".
    if [[ "$(reg_read "$name" state)" == "adopted" ]]; then
      echo "\"$name\" was adopted and is running OUTSIDE tmux — topic cannot stop it."
      echo "  Exit that session yourself (/exit in its window), then:"
      echo "    topic up \"$name\"   # relaunches it under topic management, resuming context"
      return 0
    fi
    echo "\"$name\" is already down."
    return 0
  fi
  echo "Putting down \"$name\"…"
  stop_session "$name"
  reg_write "$name" state "down" lastPutDown "$(now_iso)"
  echo "\"$name\" is down. Session retained — \`topic up \"$name\"\` resumes it."
}

cmd_handoff_path() {
  local name="${1:?usage: topic handoff-path \"<name>\"}"
  local d; d="$(topic_dir "$name")/handoffs"
  mkdir -p "$d"
  printf '%s/%s.md\n' "$d" "$(date +%Y%m%d-%H%M%S)"
}

# Which topic is the caller sitting in? Sessions are launched inside tmux under the
# topic's (mangled) name, so the tmux session name is the answer — no probing, and it
# works from any subprocess of the session.
cmd_whoami() {
  [[ -n "${TMUX:-}" ]] || die "whoami: not inside tmux — no topic to infer"
  local s; s="$(tmux display-message -p '#S' 2>/dev/null || true)"
  [[ -n "$s" ]] || die "whoami: could not read the tmux session name"

  # tmux_name() mangles ':' and '.', so map back through the registry rather than
  # trusting the tmux name to be the display name.
  local d name
  for d in "$TOPICS_ROOT"/*/; do
    [[ -f "$d/topic.json" ]] || continue
    name="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("name",""))' "$d/topic.json")"
    [[ -n "$name" ]] || continue
    if [[ "$(tmux_name "$name")" == "$s" ]]; then printf '%s\n' "$name"; return 0; fi
  done
  die "whoami: tmux session \"$s\" is not a registered topic"
}

# Where a fork brief must be written. Kept separate from handoffs/: a handoff doc
# looks backward over a topic's own history, a brief looks forward and is the child
# topic's origin document.
cmd_fork_path() {
  local name="${1:?usage: topic fork-path \"<new topic>\"}"
  local d; d="$(topic_dir "$name")/briefs"
  mkdir -p "$d"
  printf '%s/%s.md\n' "$d" "$(date +%Y%m%d-%H%M%S)"
}

# Split a thread off into its own topic, seeded with a brief.
#
#   topic fork "<new topic>" [dir] [--from "<parent>"] [--brief <file>]
#
# The brief must already be written — only the session holding the context can write
# it, exactly as with handoff. --from defaults to the caller's own topic, and the
# working directory to the parent's.
cmd_fork() {
  local name="" dir="" parent="" brief=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --from)  parent="$2"; shift 2 ;;
      --brief) brief="$2";  shift 2 ;;
      *) if [[ -z "$name" ]]; then name="$1"; else dir="$1"; fi; shift ;;
    esac
  done
  [[ -n "$name" ]] || die "usage: topic fork \"<new topic>\" [dir] [--from \"<parent>\"] [--brief <file>]"

  [[ -z "$(reg_read "$name" sessionId)" ]] ||
    die "fork: \"$name\" already exists with a session — pick another name, or \`topic up \"$name\"\`"

  # Default the parent to whoever is calling, when that is knowable. The `||` must
  # sit OUTSIDE the substitution: cmd_whoami fails via die/exit, which aborts the
  # subshell before any `|| true` inside it could run, and set -e would kill us.
  if [[ -z "$parent" ]]; then parent="$(cmd_whoami 2>/dev/null)" || parent=""; fi

  if [[ -z "$brief" ]]; then
    brief="$(ls -1t "$(topic_dir "$name")/briefs"/*.md 2>/dev/null | head -1 || true)"
  fi
  [[ -n "$brief" && -f "$brief" ]] ||
    die "fork: no brief for \"$name\" — write one first: topic fork-path \"$name\""
  [[ -s "$brief" ]] || die "fork: brief $brief is empty — refusing to fork"
  brief="$(cd "$(dirname "$brief")" && pwd)/$(basename "$brief")"

  # A fork inherits the parent's working directory unless told otherwise. Without
  # this it would land in $PWD — which, when you fork remotely through the
  # Dispatcher, is the Dispatcher's home, not the work.
  if [[ -z "$dir" && -n "$parent" ]]; then dir="$(reg_read "$parent" dir)"; fi
  [[ -n "$dir" ]] || dir="$PWD"

  local sid; sid="$(new_uuid)"
  local seed="You are starting the topic \"$name\"."
  [[ -n "$parent" ]] && seed+=" It was forked from the topic \"$parent\" to carry one thread on its own."
  seed+=" Read the brief at $brief — it was written for you by the session you were forked from, and is the only context you carry. Summarise briefly what you picked up, then continue from there."

  lock_acquire "$name"
  echo "Forking${parent:+ \"$parent\" ->} \"$name\" (new session ${sid:0:8}…) in $dir"
  echo "  brief: $brief"
  launch_session "$name" "$dir" --remote-control "$name" --name "$name" \
                 --session-id "$sid" "$seed"

  # Built as an array: an unquoted ${parent:+...} would word-split a topic name
  # like "Fantasy Economics" into two arguments and corrupt the key/value pairing.
  local kv=(name "$name" dir "$dir" sessionId "$sid" state "up"
            generation "1" seededFrom "$brief" lastPickedUp "$(now_iso)")
  [[ -n "$parent" ]] && kv+=(forkedFrom "$parent")
  reg_write "$name" "${kv[@]}"
  [[ -n "$parent" ]] && reg_push_fork "$parent" "$name"

  echo "\"$name\" is up. Remote Control name: \"$name\""
  if [[ -n "$parent" ]]; then
    echo ""
    echo "  \"$parent\" still carries this thread in its own context. To shed it:"
    echo "    topic handoff-swap \"$parent\"   # after writing its handoff doc"
  fi
}

cmd_handoff_swap() {
  local name="" doc="" focus=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --focus) focus="$2"; shift 2 ;;
      *) if [[ -z "$name" ]]; then name="$1"; else doc="$1"; fi; shift ;;
    esac
  done
  [[ -n "$name" ]] || die "usage: topic handoff-swap \"<name>\" [handoff-doc] [--focus \"<what to pick up>\"]"

  if [[ -z "$doc" ]]; then
    doc="$(ls -1t "$(topic_dir "$name")/handoffs"/*.md 2>/dev/null | head -1 || true)"
  fi
  [[ -n "$doc" && -f "$doc" ]] || die "no handoff doc found for \"$name\" — write one first (topic handoff-path \"$name\")"
  [[ -s "$doc" ]] || die "handoff doc $doc is empty — refusing to swap"

  local old_sid dir gen
  old_sid="$(reg_read "$name" sessionId)"
  dir="$(reg_read "$name" dir)"; [[ -n "$dir" ]] || dir="$PWD"
  gen="$(reg_read "$name" generation)"; [[ -n "$gen" ]] || gen=1

  echo "Handing off \"$name\" (generation $gen -> $((gen+1)))"
  echo "  handoff doc: $doc"

  # Retire the old session first so the topic stays a singleton.
  stop_session "$name"
  [[ -n "$old_sid" ]] && reg_push_history "$name" "$old_sid" "$doc"

  local new_sid; new_sid="$(new_uuid)"
  local seed="You are resuming the topic \"$name\" in a fresh session. Read the handoff document at $doc — it was written by your previous session on this topic and contains the salient context. Summarise briefly what you picked up, then continue from there."
  if [[ -n "$focus" ]]; then
    seed+=" The handoff is focused on: ${focus}. Start there. The doc also lists other open threads that were deliberately set aside — do not act on those unless asked, but do not treat them as finished either."
  fi

  launch_session "$name" "$dir" --remote-control "$name" --name "$name" --session-id "$new_sid" "$seed"

  reg_write "$name" name "$name" dir "$dir" sessionId "$new_sid" \
            state "up" generation "$((gen+1))" lastPickedUp "$(now_iso)" \
            lastHandoff "$doc"
  echo "\"$name\" is up on a fresh session (${new_sid:0:8}…). Old session archived in history."
}

# Unregister a topic. Handoff docs are KEPT by default — they are often the only
# surviving record of what a topic was about, and "stop tracking this" should not
# mean "destroy the history". --purge removes them too.
cmd_forget() {
  local name="" purge=0 dead=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --purge) purge=1; shift ;;
      --dead)  dead=1; shift ;;   # internal: set by `prune`, suppresses the
      *) name="$1"; shift ;;      # "still resumable" line for a dead session
    esac
  done
  [[ -n "$name" ]] || die "usage: topic forget \"<name>\" [--purge]"

  local d; d="$(topic_dir "$name")"
  [[ -f "$d/topic.json" ]] || die "no such topic: \"$name\""
  is_up "$name" && die "\"$name\" is still up — \`topic down \"$name\"\` first"
  [[ "$(reg_read "$name" state)" == "adopted" ]] &&
    echo "note: \"$name\" was adopted; its original session may still be running." >&2

  local sid n
  sid="$(reg_read "$name" sessionId)"
  # An absent handoffs dir makes the lister exit non-zero, and `pipefail` + `set -e`
  # would turn that into a silent abort BEFORE anything is deleted — `topic forget`
  # did exactly that for every topic with no handoff docs. The trailing `|| true`
  # is what actually fixes it; the count still comes through.
  n="$(find "$d/handoffs" "$d/briefs" -name '*.md' -type f 2>/dev/null | wc -l | tr -d ' ' || true)"
  [[ -n "$n" ]] || n=0

  if [[ $purge -eq 1 ]]; then
    rm -rf "$d"
    echo "Forgot \"$name\" and purged $n document(s)."
  else
    rm -f "$d/topic.json"
    rmdir "$d" 2>/dev/null || true   # succeeds only if nothing else remains
    echo "Forgot \"$name\"."
    [[ "$n" -gt 0 ]] && echo "  Kept $n document(s) in $d/ (--purge to remove)."
  fi
  # The session itself is untouched and still resumable directly — unless `prune`
  # already established that its transcript is gone.
  [[ -n "$sid" && $dead -eq 0 ]] && echo "  Session $sid is untouched: claude --resume $sid"
  return 0
}

# Path to a session's transcript, or "" if it no longer exists. A topic whose
# transcript is gone cannot be --resume'd: it is dead, not merely put down.
transcript_of() {
  local uuid="$1"
  [[ -n "$uuid" ]] || { printf ''; return 0; }
  find "$CLAUDE_DIR/projects" -name "$uuid.jsonl" -print -quit 2>/dev/null || printf ''
}

# The working directory a transcript recorded for itself. More reliable than
# de-mangling the project slug, which is ambiguous for any hyphenated directory.
cwd_of() {
  [[ -f "${1:-}" ]] || { printf ''; return 0; }
  python3 -c '
import json, sys
for line in open(sys.argv[1]):
    if "\"cwd\"" not in line: continue
    try: c = json.loads(line).get("cwd")
    except Exception: continue
    if c: print(c); break' "$1"
}

# Remove topics that are truly dead — down, and with no transcript left to resume.
# Dry-run by default: nothing is deleted until --yes.
#
#   topic prune [--yes] [--purge]
cmd_prune() {
  local yes=0 purge=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes|-y) yes=1; shift ;;
      --purge)  purge=1; shift ;;
      *) die "prune: unexpected argument: $1" ;;
    esac
  done

  mkdir -p "$TOPICS_ROOT"
  local dead=() d name sid
  for d in "$TOPICS_ROOT"/*/; do
    [[ -f "$d/topic.json" ]] || continue
    name="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("name",""))' "$d/topic.json")"
    [[ -n "$name" ]] || continue
    is_up "$name" && continue
    sid="$(reg_read "$name" sessionId)"
    # No sessionId at all also counts as dead: nothing to resume.
    [[ -z "$sid" || -z "$(transcript_of "$sid")" ]] && dead+=("$name")
  done

  if [[ ${#dead[@]} -eq 0 ]]; then
    echo "Nothing to prune — every down topic still has a resumable transcript."
    return 0
  fi

  echo "Dead topics (down, transcript gone — not resumable):"
  for name in "${dead[@]}"; do
    sid="$(reg_read "$name" sessionId)"
    printf '  %-30s %s\n' "$name" "${sid:-<no session>}"
  done

  if [[ $yes -eq 0 ]]; then
    echo ""
    local extra=""; [[ $purge -eq 1 ]] && extra=" --purge"
    echo "Dry run. To remove: topic prune --yes$extra"
    echo "  (handoff docs are kept unless --purge)"
    return 0
  fi

  echo ""
  for name in "${dead[@]}"; do
    if [[ $purge -eq 1 ]]; then cmd_forget "$name" --dead --purge; else cmd_forget "$name" --dead; fi
  done
}

# Every LIVE session writes ~/.claude/sessions/<pid>.json holding the authoritative
# name -> sessionId -> cwd mapping. Records are NOT removed when a session exits,
# so liveness must be re-checked against the pid.
#
# Emits one TSV line per live session: pid \t sessionId \t cwd \t name
live_sessions() {
  python3 -c '
import glob, json, os, sys
for f in sorted(glob.glob(os.path.join(sys.argv[1], "sessions", "*.json"))):
    try: d = json.load(open(f))
    except Exception: continue
    pid, sid = d.get("pid"), d.get("sessionId")
    if not pid or not sid: continue
    try: os.kill(int(pid), 0)          # stale record from an exited session
    except OSError: continue
    print("\t".join(str(x) for x in (pid, sid, d.get("cwd",""), d.get("name",""))))' "$CLAUDE_DIR"
}

# A session that has EXITED still carries its name: the transcript holds
# `{"type":"custom-title","customTitle":"..."}` records, and that is the name
# `claude --resume` lists it under. The title is re-stamped on every rename, so the
# LAST one is the current name — an early record may be a name since abandoned.
# The transcript also records its own `cwd`, which beats de-mangling the project
# slug (that is ambiguous for any directory containing a hyphen).
#
# Emits, newest first: uuid \t cwd \t last-modified
sessions_by_title() {
  local want="$1"
  # grep narrows to plausible files first; a 25MB transcript is cheap to scan but
  # there are many of them.
  local f last cwd
  # Two greps per candidate beat scanning multi-megabyte transcripts line by line
  # in Python — this runs on every `topic adopt`.
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    last="$(grep -F '"type":"custom-title"' "$f" 2>/dev/null | tail -1 || true)"
    [[ -n "$last" ]] || continue
    python3 -c '
import json, os, sys, time
f, want, last = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    if json.loads(last).get("customTitle") != want: sys.exit(0)   # renamed away
except Exception: sys.exit(0)
print("\t".join((os.path.basename(f)[:-6], sys.argv[4],
                 time.strftime("%Y-%m-%d %H:%M", time.localtime(os.stat(f).st_mtime)))))' \
      "$f" "$want" "$last" "$(cwd_of "$f")"
  done < <(grep -rl --include='*.jsonl' -F "\"customTitle\":\"$want\"" "$CLAUDE_DIR/projects" 2>/dev/null || true) \
    | sort -t'	' -k3,3r
}

# Adopt a session that has EXITED but is still resumable — the ones `claude --resume`
# lists. There is no process to claim, so the topic lands in the ordinary `down`
# state: `topic up` just resumes it, no --claim dance.
#
#   adopt_resumable <topic-name> <title-override> <dir> [--quiet]
#
# --quiet: return 1 instead of dying when nothing matches, so the live-session path
# can fall through to this speculatively. Ambiguity is still reported either way —
# that means we DID find it and the user only needs to pick.
adopt_resumable() {
  local name="$1" title="${2:-}" dir="${3:-}" quiet="${4:-}"
  [[ -n "$title" ]] || title="$name"

  local rows=() row
  while IFS= read -r row; do
    [[ -z "$row" ]] && continue
    [[ -n "$dir" && "$(printf '%s' "$row" | cut -f2)" != "$dir" ]] && continue
    rows+=("$row")
  done < <(sessions_by_title "$title")

  if [[ ${#rows[@]} -eq 0 ]]; then
    [[ "$quiet" == "--quiet" ]] && return 1
    echo "adopt: no live session and no resumable session titled \"$title\"." >&2
    echo "  Titles come from the session's own transcript — check \`claude --resume\`." >&2
    echo "  If it is named differently there: topic adopt \"$name\" --title \"<that name>\"" >&2
    die "nothing to adopt"
  fi

  if [[ ${#rows[@]} -gt 1 ]]; then
    echo "adopt: ${#rows[@]} resumable sessions are titled \"$title\" — pick one:" >&2
    for row in "${rows[@]}"; do
      printf '  --session-id %s  last active %s  %s\n' \
        "$(printf '%s' "$row" | cut -f1)" \
        "$(printf '%s' "$row" | cut -f3)" \
        "$(printf '%s' "$row" | cut -f2)" >&2
    done
    die "expected exactly one match (newest listed first)"
  fi

  local uuid cwd seen
  uuid="$(printf '%s' "${rows[0]}" | cut -f1)"
  cwd="$(printf '%s' "${rows[0]}" | cut -f2)"

  # It should not be running — the live path would have caught it — but the title
  # may differ from the advertised name, so check the UUID before calling it down.
  seen="$(live_sessions || true)"
  if [[ "$seen" == *"	$uuid	"* ]]; then
    die "adopt: session ${uuid:0:8}… is currently RUNNING — adopt it live: topic adopt \"$name\" --pid <pid>"
  fi

  reg_write "$name" name "$name" dir "${dir:-${cwd:-$HOME}}" sessionId "$uuid" \
            generation "1" state "down" adoptedAt "$(now_iso)"
  echo "Adopted \"$name\" -> session ${uuid:0:8}… (resumable, titled \"$title\", dir: ${dir:-${cwd:-$HOME}})"
  echo "  Not running, so nothing to claim. Pick it up with:"
  echo "    topic up \"$name\""
}

# Adopt an already-running session that topic did not launch.
#
# Preferred path: read ~/.claude/sessions/<pid>.json, which already knows the
# session UUID — no probe, no round trip. `topic adopt "<name>"` narrows the live
# sessions by --pid, then --dir, then by a name equal to the topic name, and
# adopts if exactly one candidate survives.
#
# Fallback path (--probe): for a session with no live record — it exited, or its
# record is unreadable. A running session does not hold its transcript open, so
# instead the caller sends the target a unique token via SendMessage and names it
# here; we find which transcript the token landed in. The caller's OWN transcript
# also contains the token (it sent it), hence --exclude.
#
#   topic adopt "<name>" [--pid <pid>] [--dir <dir>] [--exclude <uuid>]
#   topic adopt "<name>" --probe <token> [--dir <dir>] [--exclude <uuid>]
cmd_adopt() {
  local name="${1:?usage: topic adopt \"<name>\" [--pid <pid>] [--dir <dir>] | --probe <token>}"; shift
  local probe="" dir="" exclude="" pid="" title=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --probe)      probe="$2"; shift 2 ;;
      --dir)        dir="$2"; shift 2 ;;
      --pid)        pid="$2"; shift 2 ;;
      --title)      title="$2"; shift 2 ;;
      --exclude)    exclude="$2"; shift 2 ;;
      --session-id) known_uuid="$2"; shift 2 ;;
      *) die "adopt: unexpected argument: $1" ;;
    esac
  done

  # A session whose UUID is already known — a session adopting itself, or the user
  # picking one out of an ambiguous list.
  if [[ -n "${known_uuid:-}" ]]; then
    local seen kpid="" kdir="$dir"
    seen="$(live_sessions || true)"
    kpid="$(printf '%s\n' "$seen" | grep -F "	$known_uuid	" | cut -f1 || true)"

    if [[ -z "$kdir" ]]; then
      # The transcript records its own cwd; fall back to $PWD only if it has none.
      local t; t="$(transcript_of "$known_uuid")"
      [[ -n "$t" ]] && kdir="$(cwd_of "$t")"
      [[ -n "$kdir" ]] || kdir="$PWD"
    fi

    if [[ -n "$kpid" ]]; then
      reg_write "$name" name "$name" dir "$kdir" sessionId "$known_uuid" \
                generation "1" state "adopted" adoptedAt "$(now_iso)" adoptedPid "$kpid"
      echo "Adopted \"$name\" -> session ${known_uuid:0:8}… (pid $kpid, dir: $kdir)"
      echo "  Still running OUTSIDE topic management. Exit it, then: topic up \"$name\""
    else
      # Not running: an ordinary resumable session, nothing to claim.
      reg_write "$name" name "$name" dir "$kdir" sessionId "$known_uuid" \
                generation "1" state "down" adoptedAt "$(now_iso)"
      echo "Adopted \"$name\" -> session ${known_uuid:0:8}… (resumable, dir: $kdir)"
      echo "  Not running, so nothing to claim. Pick it up with: topic up \"$name\""
    fi
    return 0
  fi

  # ---- preferred path: the live session already published its own UUID --------
  if [[ -z "$probe" ]]; then
    local all=() rows=() row
    while IFS= read -r row; do
      [[ -n "$exclude" && "$row" == *"	$exclude	"* ]] && continue
      all+=("$row")
    done < <(live_sessions)

    # Nothing live at all: go straight to the resumable-session path.
    [[ ${#all[@]} -gt 0 ]] || { adopt_resumable "$name" "$title" "$dir"; return $?; }

    # Narrow progressively; keep the last filter that left at least one candidate.
    rows=("${all[@]}")
    local filtered=()
    _narrow() {  # _narrow <awk-field> <value>
      filtered=()
      for row in "${rows[@]}"; do
        [[ "$(printf '%s' "$row" | cut -f"$1")" == "$2" ]] && filtered+=("$row")
      done
      # A filter that matches nothing is ignored, not fatal — keep the wider set
      # and let the caller disambiguate. Must return 0 or `set -e` kills us.
      [[ ${#filtered[@]} -gt 0 ]] && rows=("${filtered[@]}")
      return 0
    }
    # --pid is an explicit assertion: if it matches no live session, say so rather
    # than quietly adopting something else.
    if [[ -n "$pid" ]]; then
      _narrow 1 "$pid"
      [[ "$(printf '%s' "${rows[0]}" | cut -f1)" == "$pid" ]] ||
        die "adopt: no live session with pid $pid (see ~/.claude/sessions)"
    fi
    [[ -n "$dir" ]] && _narrow 3 "$dir"
    _narrow 4 "$name"

    # Live sessions exist but none is ours — the target is probably a resumable
    # session that has exited. Try that before making the user disambiguate.
    if [[ ${#rows[@]} -ne 1 ]] && adopt_resumable "$name" "$title" "$dir" --quiet; then
      return 0
    fi

    if [[ ${#rows[@]} -ne 1 ]]; then
      # Distinguish "your filters left several" from "nothing matched at all" — the
      # resumable-session fallback has already come up empty by this point.
      if [[ ${#rows[@]} -eq ${#all[@]} && -z "$pid" && -z "$dir" ]]; then
        echo "adopt: no live session named \"$name\", and no resumable session titled" >&2
        echo "  \"${title:-$name}\". Pick a live one with --pid, or --title if it is" >&2
        echo "  listed under a different name in \`claude --resume\`:" >&2
      else
        echo "adopt: ${#rows[@]} live sessions match — disambiguate with --pid (or --dir):" >&2
      fi
      for row in "${rows[@]}"; do
        printf '  --pid %-7s %-40s %s\n' \
          "$(printf '%s' "$row" | cut -f1)" \
          "$(printf '%s' "$row" | cut -f4)" \
          "$(printf '%s' "$row" | cut -f3)" >&2
      done
      die "expected exactly one match"
    fi

    local uuid; uuid="$(printf '%s' "${rows[0]}" | cut -f2)"
    local spid; spid="$(printf '%s' "${rows[0]}" | cut -f1)"
    local sdir; sdir="$(printf '%s' "${rows[0]}" | cut -f3)"
    local sname; sname="$(printf '%s' "${rows[0]}" | cut -f4)"
    [[ -n "$dir" ]] || dir="${sdir:-$HOME}"

    reg_write "$name" name "$name" dir "$dir" sessionId "$uuid" \
              generation "1" state "adopted" adoptedAt "$(now_iso)" adoptedPid "$spid"
    echo "Adopted \"$name\" -> session ${uuid:0:8}… (pid $spid, advertised as \"${sname:-?}\", dir: $dir)"
    echo "  Still running OUTSIDE topic management as pid $spid."
    echo "  Exit that session, then: topic up \"$name\""
    echo "  (no --claim needed — the pid is on record, so topic checks it for you)"
    return 0
  fi

  local projects="$CLAUDE_DIR/projects"
  local hits=() f uuid
  while IFS= read -r f; do
    uuid="$(basename "$f" .jsonl)"
    [[ -n "$exclude" && "$uuid" == "$exclude" ]] && continue
    hits+=("$f")
  done < <(grep -rl -- "$probe" "$projects" 2>/dev/null | grep '\.jsonl$' || true)

  case "${#hits[@]}" in
    0) die "adopt: probe token \"$probe\" not found in any transcript — did the target session receive it?" ;;
    1) : ;;
    *) echo "adopt: probe matched ${#hits[@]} transcripts — cannot disambiguate:" >&2
       printf '  %s\n' "${hits[@]}" >&2
       die "re-run with --exclude <your-own-session-uuid>" ;;
  esac

  uuid="$(basename "${hits[0]}" .jsonl)"

  # Derive the working directory from the transcript's project slug if not given.
  if [[ -z "$dir" ]]; then
    local slug; slug="$(basename "$(dirname "${hits[0]}")")"
    dir="$(printf '%s' "$slug" | sed 's|^-|/|; s|-|/|g')"
    [[ -d "$dir" ]] || dir="$HOME"
  fi

  reg_write "$name" name "$name" dir "$dir" sessionId "$uuid" \
            generation "1" state "adopted" adoptedAt "$(now_iso)"
  echo "Adopted \"$name\" -> session ${uuid:0:8}… (dir: $dir)"
  echo "  It is still running OUTSIDE topic management (no tmux, no --name)."
  echo "  \`topic down \"$name\"\` then \`topic up \"$name\"\` brings it fully under management."
}

cmd_status() {
  local name="${1:?usage: topic status \"<name>\"}"
  local f; f="$(topic_json "$name")"
  [[ -f "$f" ]] || die "no such topic: \"$name\""
  local state; if is_up "$name"; then state="UP"; else state="down"; fi
  echo "$name  [$state]"
  python3 -c '
import json,sys
d=json.load(open(sys.argv[1]))
for k in ("dir","sessionId","generation","forkedFrom","seededFrom","movedFrom",
          "movedAt","lastPickedUp","lastPutDown","lastHandoff"):
    if d.get(k): print(f"  {k}: {d[k]}")
forks=d.get("forks") or []
if forks: print("  forks: " + ", ".join(forks))
h=d.get("history") or []
if h: print(f"  retired sessions: {len(h)}")' "$f"
}

cmd_list() {
  # --all crosses every profile on the machine, so you can see the whole picture
  # without knowing which profile a topic lives in.
  if [[ "${1:-}" == "--all" ]]; then
    local p tag root d name state any=0
    while IFS= read -r p; do
      root="$p/topics"
      [[ -d "$root" ]] || continue
      tag="$(profile_tag_of "$p")"
      for d in "$root"/*/; do
        [[ -f "$d/topic.json" ]] || continue
        name="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("name",""))' "$d/topic.json")"
        [[ -n "$name" ]] || continue
        any=1
        if tmux has-session -t "=$(tmux_name_in "$tag" "$name")" 2>/dev/null; then
          state="UP    "
        else
          state="down  "
        fi
        printf '  %-7s %-12s %s\n' "$state" "${tag:-(default)}" "$name"
      done
    done < <(list_profiles)
    [[ $any -eq 1 ]] || echo "  (no topics in any profile)"
    return 0
  fi

  mkdir -p "$TOPICS_ROOT"
  # Say which profile these topics belong to whenever it is not the default one —
  # otherwise a short list looks like topics have gone missing.
  [[ -n "$TMUX_PREFIX" ]] && echo "  (profile: $CLAUDE_DIR)"
  local found=0 d name state
  for d in "$TOPICS_ROOT"/*/; do
    [[ -f "$d/topic.json" ]] || continue
    found=1
    name="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("name",""))' "$d/topic.json")"
    [[ -n "$name" ]] || continue
    # An adopted topic is running outside tmux, so is_up() cannot see it.
    # Report that honestly rather than calling a live session "down".
    if is_up "$name"; then
      state="UP    "
    elif [[ "$(reg_read "$name" state)" == "adopted" ]]; then
      state="ADOPTED"
    else
      state="down  "
    fi
    printf '  %-7s %s\n' "$state" "$name"
  done
  [[ $found -eq 1 ]] || echo "  (no topics yet — \`topic up \"<name>\" [dir]\` creates one)"
}

# Put every live topic in this profile down, losslessly. Used by `topics-cycle` and
# by hand before logging a profile in and out.
#
# The caller's OWN topic is skipped by default: putting it down terminates the
# session running this command, so the rest of the loop would never execute.
cmd_down_all() {
  local include_self=0 dry=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --include-self) include_self=1; shift ;;
      --dry-run)      dry=1; shift ;;
      *) die "down-all: unexpected argument: $1" ;;
    esac
  done

  local self; self="$(cmd_whoami 2>/dev/null)" || self=""
  local d name did=0 skipped=""
  for d in "$TOPICS_ROOT"/*/; do
    [[ -f "$d/topic.json" ]] || continue
    name="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("name",""))' "$d/topic.json")"
    [[ -n "$name" ]] || continue
    is_up "$name" || continue
    if [[ "$name" == "$self" && $include_self -eq 0 ]]; then skipped="$name"; continue; fi
    did=1
    if [[ $dry -eq 1 ]]; then echo "  would put down: $name"; else cmd_down "$name"; fi
  done

  [[ $did -eq 1 ]] || echo "  nothing up in this profile."
  if [[ -n "$skipped" ]]; then
    echo ""
    echo "  Skipped \"$skipped\" — it is the session running this command."
    echo "  Put it down last, yourself:  topic down \"$skipped\""
  fi
}

# Name every profile on this machine, marking the active one.
cmd_profiles() {
  local d tag n
  while IFS= read -r d; do
    tag="$(profile_tag_of "$d")"
    n=0
    if [[ -d "$d/topics" ]]; then
      n="$(find "$d/topics" -maxdepth 2 -name topic.json -type f 2>/dev/null | wc -l | tr -d ' ' || true)"
    fi
    local note=""
    profile_onboarded "$d" || note="  ** first-run setup not finished — sessions will not start"
    printf '  %s %-26s %-11s %2s topic(s)%s\n' \
      "$([[ "$d" == "$CLAUDE_DIR" ]] && echo '*' || echo ' ')" \
      "$d" "${tag:-(default)}" "$n" "$note"
  done < <(list_profiles)
  echo
  echo "  * = active. Use another with: CLAUDE_CONFIG_DIR=<dir> topic <cmd>"
}

# Move a topic — registry, handoff docs, briefs, and every transcript it can still
# resume — from this profile into another one.
#
#   topic move "<name>" --to <profile> [--copy] [--dry-run]
#
# The transcript is the part that matters: `topic up` resumes by UUID, and
# `claude --resume` only looks inside its own profile's projects/ directory. Move the
# registry without the transcript and the topic arrives unresumable.
cmd_move() {
  local name="" to="" copy=0 dry=0 stay_down=0 keep_bridge=0 force=0 carry=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --to)          to="$2"; shift 2 ;;
      --copy)        copy=1; shift ;;
      --dry-run)     dry=1; shift ;;
      --stay-down)   stay_down=1; shift ;;
      --keep-bridge) keep_bridge=1; shift ;;
      --force)       force=1; shift ;;
      --carry-approvals) carry=1; shift ;;
      *) if [[ -z "$name" ]]; then name="$1"; else die "move: unexpected argument: $1"; fi; shift ;;
    esac
  done
  [[ -n "$name" ]] || die "usage: topic move \"<name>\" --to <profile> [--copy] [--stay-down] [--keep-bridge] [--dry-run]"
  [[ -n "$to" ]]   || die "move: --to <profile> is required (a tag like \"v3rv\", \"default\", or a path)"

  local dst; dst="$(resolve_profile "$to")"
  [[ "$dst" != "$CLAUDE_DIR" ]] || die "move: \"$name\" is already in $dst"
  [[ -d "$dst" ]] || die "move: no such profile directory: $dst"
  [[ -d "$dst/projects" || -f "$dst/.claude.json" ]] ||
    die "move: $dst does not look like a Claude Code config dir (no projects/ or .claude.json)"

  # Moving into a profile that cannot start a session strands the topic there.
  if ! profile_onboarded "$dst"; then
    echo "move: profile $dst has not completed first-run setup, so \"$name\" could not" >&2
    echo "  be started there. Run it once interactively first:" >&2
    echo "    CLAUDE_CONFIG_DIR=$dst claude" >&2
    die "destination profile not set up"
  fi

  local src_dir; src_dir="$(topic_dir "$name")"
  [[ -f "$src_dir/topic.json" ]] || die "no such topic in this profile: \"$name\""

  # A live session belongs to the profile that launched it — its process, its tmux
  # session, its open transcript — so a live topic is put down first and brought back
  # up on the far side. Both halves are lossless: the session UUID is stable and `up`
  # is a real --resume, so the session continues where it left off, in the new profile.
  # An ADOPTED topic runs outside tmux, so is_up() cannot see it. Moving its
  # transcript while the process still holds it open would corrupt it — and unlike a
  # topic-managed session, topic cannot stop it for the user.
  if [[ "$(reg_read "$name" state)" == "adopted" ]]; then
    local apid asid live
    apid="$(reg_read "$name" adoptedPid)"
    asid="$(reg_read "$name" sessionId)"
    live="$(live_sessions || true)"
    if [[ -n "$apid" && "$live" == *"$apid	$asid	"* ]]; then
      echo "\"$name\" was adopted and is still running as pid $apid, outside tmux." >&2
      echo "  Its transcript is open and being written; moving it would corrupt it," >&2
      echo "  and topic cannot stop a session it did not launch." >&2
      echo "  Exit that session (/exit in its window), then re-run this move." >&2
      die "refusing to move a live adopted session"
    fi
  fi

  # Per-project approvals are recorded per profile and do NOT move with the topic, so
  # a topic can arrive somewhere it is not allowed to start. The trust dialog is
  # auto-accepted, but the external-CLAUDE.md-imports question is a security decision
  # topic will not answer — and it only ever gets approved by being asked, so the
  # source having approved it is exactly the signal that the destination will be
  # asked too. Check BEFORE moving anything.
  local work_dir; work_dir="$(reg_read "$name" dir)"
  if [[ -n "$work_dir" ]]; then
    local src_ok dst_ok
    src_ok="$(project_flag "$(config_file_of "$CLAUDE_DIR")" "$work_dir" hasClaudeMdExternalIncludesApproved)"
    dst_ok="$(project_flag "$(config_file_of "$dst")" "$work_dir" hasClaudeMdExternalIncludesApproved)"
    if [[ "$src_ok" == "True" && "$dst_ok" != "True" ]]; then
      echo "move: $dst has not approved external CLAUDE.md imports for $work_dir." >&2
      echo "  That approval is per profile and does not travel with the topic, so" >&2
      echo "  \"$name\" would arrive unable to start. Answer it once:" >&2
      echo "    (cd $work_dir && CLAUDE_CONFIG_DIR=$dst claude)" >&2
      echo "  then re-run this move. (--force moves anyway and leaves it down.)" >&2
      if [[ $carry -eq 1 ]]; then
        echo "  --carry-approvals given: copying your existing approval across." >&2
      else
        echo "  Or copy your existing approval across: --carry-approvals" >&2
        [[ $force -eq 1 ]] || die "destination profile would not be able to start it"
        echo "  --force given: moving anyway." >&2
      fi
    fi
  fi

  local was_up=0
  if is_up "$name"; then
    was_up=1
    # Refusing to move ourselves is not fussiness: `down` terminates the session
    # running this command, so the move would never happen and the topic would be
    # left down, half-moved at best.
    local self; self="$(cmd_whoami 2>/dev/null)" || self=""
    if [[ -n "$self" && "$self" == "$name" ]]; then
      echo "\"$name\" is the topic you are running this from." >&2
      echo "  Putting it down would kill this command mid-move." >&2
      echo "  Run it from another session — the Dispatcher is there for exactly this:" >&2
      echo "    topic move \"$name\" --to ${to}" >&2
      die "refusing to move the calling topic"
    fi
    # A copy that is also running would diverge from its original the moment either
    # side is resumed. Take the copy while it is quiet instead.
    [[ $copy -eq 1 ]] &&
      die "move: \"$name\" is up — --copy needs it down first (\`topic down \"$name\"\`)"
  fi

  local dst_dir="$dst/topics/$(slugify "$name")"
  [[ -e "$dst_dir" ]] && die "move: \"$name\" already exists in $dst ($dst_dir)"

  # Every session this topic can still resume: the current one plus every retired
  # session in its history. Leaving history transcripts behind would silently break
  # the emergency path back to a pre-handoff session.
  local uuids=() u
  while IFS= read -r u; do [[ -n "$u" ]] && uuids+=("$u"); done < <(python3 -c '
import json,sys
d=json.load(open(sys.argv[1]))
seen=[]
if d.get("sessionId"): seen.append(d["sessionId"])
for h in (d.get("history") or []):
    if h.get("sessionId"): seen.append(h["sessionId"])
print("\n".join(dict.fromkeys(seen)))' "$src_dir/topic.json")

  local verb="Moving"; [[ $copy -eq 1 ]] && verb="Copying"
  echo "$verb \"$name\": $CLAUDE_DIR -> $dst"
  [[ $was_up -eq 1 ]] && echo "  it is UP: will put it down, move, and bring it back up in $dst"
  [[ $keep_bridge -eq 0 ]] && echo "  remote control: will re-register under the destination profile's account"
  echo "  registry: $src_dir -> $dst_dir"

  # Work out each transcript's destination before touching anything, so a dry run
  # shows the whole picture and a real run does not stop half-done.
  local moves=() t rel
  for u in "${uuids[@]}"; do
    t="$(find "$CLAUDE_DIR/projects" -name "$u.jsonl" -print -quit 2>/dev/null || true)"
    if [[ -z "$t" ]]; then
      echo "  transcript ${u:0:8}…: not found in this profile (already gone) — skipping"
      continue
    fi
    rel="$(basename "$(dirname "$t")")"          # the project-slug directory
    moves+=("$t|$dst/projects/$rel/$u.jsonl")
    echo "  transcript ${u:0:8}…: -> $dst/projects/$rel/"
  done

  if [[ $dry -eq 1 ]]; then
    echo ""
    echo "Dry run — nothing moved."
    return 0
  fi

  # Put it down BEFORE moving anything: while the session runs it holds its
  # transcript open and keeps writing to it.
  if [[ $was_up -eq 1 ]]; then
    echo ""
    cmd_down "$name" | sed 's/^/  /'
    # `down` returns once claude has left the pane, but the process can still flush a
    # final record on its way out — which lands at the OLD path and recreates a stub
    # there after the move. Wait for each transcript to stop changing first.
    for m in "${moves[@]}"; do settle "${m%%|*}"; done
    echo ""
  fi

  local m from into
  for m in "${moves[@]}"; do
    from="${m%%|*}"; into="${m##*|}"
    mkdir -p "$(dirname "$into")"
    [[ -e "$into" ]] && die "move: $into already exists — refusing to overwrite"
    if [[ $copy -eq 1 ]]; then cp "$from" "$into"; else mv "$from" "$into"; fi
  done

  # Belt and braces: if a late flush still recreated a stub at the source path, drop
  # it — but only when it is strictly smaller than what we moved, so a real
  # transcript is never deleted on the strength of a race we merely suspect.
  if [[ $copy -eq 0 ]]; then
    for m in "${moves[@]}"; do
      from="${m%%|*}"; into="${m##*|}"
      [[ -f "$from" && -f "$into" ]] || continue
      if [[ "$(stat -f %z "$from")" -lt "$(stat -f %z "$into")" ]]; then
        rm -f "$from"
        echo "  (removed a $(basename "$from" .jsonl | cut -c1-8)… stub the exiting session left behind)"
      else
        echo "  WARNING: $from reappeared and is not smaller than the moved copy — left in place." >&2
      fi
    done
  fi

  mkdir -p "$(dirname "$dst_dir")"
  if [[ $copy -eq 1 ]]; then cp -R "$src_dir" "$dst_dir"; else mv "$src_dir" "$dst_dir"; fi

  # Record where it came from: after a move the old profile has no trace of it, and
  # "why is this topic here?" is a real question months later.
  python3 -c '
import json,os,sys
f,src=sys.argv[1],sys.argv[2]
d=json.load(open(f))
d["movedFrom"]=src
d["movedAt"]=sys.argv[3]
tmp=f+".tmp"; json.dump(d,open(tmp,"w"),indent=2); os.replace(tmp,f)' \
    "$dst_dir/topic.json" "$CLAUDE_DIR" "$(now_iso)"

  # A moved topic must present itself as belonging to where it now lives. Remote
  # Control identity — the name shown in the Claude UI and the ACCOUNT it appears
  # under — is pinned to the bridge recorded in the transcript, so without this the
  # topic keeps advertising its old profile's account under a hostname-derived name,
  # and --remote-control is silently ignored on resume.
  if [[ $keep_bridge -eq 0 ]]; then
    local moved_tr; moved_tr="$(find "$dst/projects" -name "$(reg_read_at "$dst_dir/topic.json" sessionId).jsonl" -print -quit 2>/dev/null || true)"
    if [[ -n "$moved_tr" ]]; then
      local dropped; dropped="$(drop_bridge_records "$moved_tr" "$dst_dir/backups")"
      [[ -n "$dropped" ]] &&
        echo "  remote control: dropped bridge ${dropped:0:16}… — it will re-register in $(profile_tag_of "$dst" || echo default)'s account"
    fi
  fi

  # Carry the user's own prior approvals for THIS directory into the destination.
  # Deliberately limited to the trust and external-imports answers: the same project
  # entry also holds allowedTools, and copying a permission allowlist into a profile
  # that never granted it would be a silent escalation.
  if [[ $carry -eq 1 && -n "$work_dir" ]]; then
    python3 -c '
import json,os,sys
src,dstf,wd = sys.argv[1],sys.argv[2],sys.argv[3]
KEYS=("hasTrustDialogAccepted","hasClaudeMdExternalIncludesApproved")
try: s=json.load(open(src))
except Exception: sys.exit(0)
sp=(s.get("projects") or {}).get(wd) or {}
carry={k:sp[k] for k in KEYS if k in sp}
if not carry: sys.exit(0)
try: d=json.load(open(dstf))
except Exception: d={}
d.setdefault("projects",{}).setdefault(wd,{}).update(carry)
tmp=dstf+".tmp"
json.dump(d,open(tmp,"w"),indent=2)
os.replace(tmp,dstf)
print("  carried approvals: " + ", ".join(f"{k}={v}" for k,v in carry.items()))' \
      "$(config_file_of "$CLAUDE_DIR")" "$(config_file_of "$dst")" "$work_dir"
  fi

  local tag; tag="$(profile_tag_of "$dst")"

  # Bring it back up on the far side, by re-invoking ourselves against the
  # destination profile — every path, name and prefix is derived from
  # CLAUDE_CONFIG_DIR at startup, so this is the only way to get a consistent view
  # of the profile we just moved into.
  if [[ $was_up -eq 1 && $stay_down -eq 0 ]]; then
    echo ""
    echo "Bringing \"$name\" back up in $dst"
    local self_path; self_path="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    # Unset rather than set-to-default for the default profile — see launch_session.
    local started=1
    if [[ "$dst" == "$HOME/.claude" ]]; then
      env -u CLAUDE_CONFIG_DIR "$self_path" up "$name" 2>&1 | sed 's/^/  /' || started=0
    else
      CLAUDE_CONFIG_DIR="$dst" "$self_path" up "$name" 2>&1 | sed 's/^/  /' || started=0
    fi
    if [[ $started -eq 0 ]]; then
      # The move itself succeeded — say so plainly rather than letting a failed
      # restart read as a failed move.
      echo ""
      echo "\"$name\" MOVED to $dst but could not be started there (see above)."
      echo "  Nothing is lost: it is down and resumable. Once the blocker is cleared:"
      echo "    CLAUDE_CONFIG_DIR=$dst topic up \"$name\""
      return 1
    fi
    echo ""
    echo "Moved and running. It is now a ${tag:-default}-profile topic:"
    echo "  attach:  tmux attach -t \"$(tmux_name_in "$tag" "$name")\""
    echo "  manage:  CLAUDE_CONFIG_DIR=$dst topic <cmd> \"$name\""
    return 0
  fi

  echo ""
  echo "Done. Pick it up in its new profile with:"
  if [[ -n "$tag" ]]; then
    echo "  CLAUDE_CONFIG_DIR=$dst topic up \"$name\""
    echo "  (its tmux session will be \"$(tmux_name_in "$tag" "$name")\")"
  else
    echo "  topic up \"$name\""
  fi
  [[ $copy -eq 1 ]] && echo "  The original is still in $CLAUDE_DIR — resuming both would fork the transcript."
  return 0
}

# Drop the bridge-session records from a transcript, keeping a copy first. The next
# launch then mints a fresh Remote Control bridge instead of rejoining the old one.
#   drop_bridge_records <transcript> <backup-dir>  -> prints the old bridge id, or ""
drop_bridge_records() {
  local tr="$1" bk="$2" old
  [[ -f "$tr" ]] || { printf ''; return 0; }
  old="$(grep -o '"bridgeSessionId":"[^"]*"' "$tr" 2>/dev/null | tail -1 | cut -d'"' -f4 || true)"
  [[ -n "$old" ]] || { printf ''; return 0; }

  # Editing a transcript is unsupported, so never do it without a copy.
  mkdir -p "$bk"
  cp "$tr" "$bk/$(basename "$tr" .jsonl)-$(date +%Y%m%d-%H%M%S).jsonl"

  python3 -c '
import json,os,sys
f=sys.argv[1]; keep=[]
for line in open(f):
    try: d=json.loads(line)
    except Exception: keep.append(line); continue
    if d.get("type")=="bridge-session": continue
    keep.append(line)
tmp=f+".tmp"
open(tmp,"w").writelines(keep)
os.replace(tmp,f)' "$tr"
  printf '%s' "$old"
}

# The Remote Control identity a session presents — its NAME in the Claude UI and the
# ACCOUNT it appears under — is fixed when its bridge session is first created, and
# recorded in the transcript as `{"type":"bridge-session",...}`. On resume Claude Code
# rejoins that bridge, so `--remote-control "<name>"` has no effect on an existing
# session: a topic moved to another profile keeps the name and account it was first
# registered with, and an unnamed one keeps its hostname-derived auto-name.
#
# Dropping those records makes the next launch mint a fresh bridge, which picks up
# --remote-control properly. Verified 2026-08-09: new bridge id, correct name, correct
# account, local conversation intact.
#
# COST: the CLOUD conversation restarts. The local transcript keeps everything and the
# session resumes with its full history, but the Claude UI shows the topic from the
# re-mint onwards, and the previous cloud entry is orphaned — still listed, still
# renameable, no longer connected to anything. Use --keep-bridge on `move` when
# continuous cloud history matters more than a correct name and account.
#
#   topic rename "<old>" "<new>"
#                               Rename a topic everywhere: registry, tmux, peer name,
#                               Claude UI name, and transcript title.
#   topic rebridge "<name>"|--all [--down-only] [--dry-run]
#
# Editing a transcript is unsupported, so the original is copied to
# <topic>/backups/ first.
cmd_rebridge() {
  local name="" all=0 dry=0 down_only=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all)       all=1; shift ;;
      --down-only) down_only=1; shift ;;   # leave running sessions undisturbed
      --dry-run)   dry=1; shift ;;
      *) name="$1"; shift ;;
    esac
  done
  [[ -n "$name" || $all -eq 1 ]] || die "usage: topic rebridge \"<name>\"|--all [--dry-run]"

  local self; self="$(cmd_whoami 2>/dev/null)" || self=""
  local targets=() d n
  if [[ $all -eq 1 ]]; then
    for d in "$TOPICS_ROOT"/*/; do
      [[ -f "$d/topic.json" ]] || continue
      n="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("name",""))' "$d/topic.json")"
      [[ -n "$n" ]] || continue
      if [[ -n "$self" && "$n" == "$self" ]]; then
        echo "  skipping \"$n\" — it is the session running this command"
        continue
      fi
      # --down-only: a live session would have to be restarted to re-register, and
      # a down one re-registers for free on its next pickup.
      if [[ $down_only -eq 1 ]] && is_up "$n"; then continue; fi
      targets+=("$n")
    done
  else
    [[ -z "$self" || "$name" != "$self" ]] ||
      die "rebridge: \"$name\" is the session running this command — run it from another session"
    targets+=("$name")
  fi

  local t sid tr old was_up
  for t in "${targets[@]}"; do
    sid="$(reg_read "$t" sessionId)"
    if [[ -z "$sid" ]]; then echo "  $t: no session — skipping"; continue; fi
    tr="$(transcript_of "$sid")"
    if [[ -z "$tr" ]]; then echo "  $t: no transcript in this profile — skipping"; continue; fi

    old="$(grep -o '"bridgeSessionId":"[^"]*"' "$tr" 2>/dev/null | tail -1 | cut -d'"' -f4 || true)"
    if [[ -z "$old" ]]; then echo "  $t: no bridge session recorded — nothing to do"; continue; fi

    was_up=0; is_up "$t" && was_up=1
    if [[ $dry -eq 1 ]]; then
      echo "  $t: would drop bridge ${old:0:16}…$([[ $was_up -eq 1 ]] && echo ' (restart needed)')"
      continue
    fi

    printf '  %s: bridge %s… -> ' "$t" "${old:0:16}"
    if [[ $was_up -eq 1 ]]; then
      cmd_down "$t" >/dev/null 2>&1
      settle "$tr"
    fi

    drop_bridge_records "$tr" "$(topic_dir "$t")/backups" >/dev/null

    if [[ $was_up -eq 1 ]]; then
      cmd_up "$t" >/dev/null 2>&1 || true
      local new; new="$(grep -o '"bridgeSessionId":"[^"]*"' "$tr" 2>/dev/null | tail -1 | cut -d'"' -f4 || true)"
      echo "${new:0:16}… (restarted)"
    else
      echo "cleared (next \`topic up\` mints a fresh one)"
    fi
  done
}

# Rename a topic everywhere it is named. A topic's name appears in five places and
# they drift apart easily — /rename in the Claude UI, for instance, changes only the
# cloud one:
#   1. the registry directory (slugified) and its `name` field
#   2. the tmux session
#   3. --name, the peer name other sessions see in ListAgents
#   4. --remote-control, the name in the Claude UI — pinned to the bridge, so this
#      requires a re-mint (see rebridge; the cloud conversation restarts)
#   5. the transcript's custom-title, which is what `adopt` searches by
#
#   topic rename "<old>" "<new>" [--dry-run]
cmd_rename() {
  local old="" new="" dry=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) dry=1; shift ;;
      *) if [[ -z "$old" ]]; then old="$1"; elif [[ -z "$new" ]]; then new="$1";
         else die "rename: unexpected argument: $1"; fi; shift ;;
    esac
  done
  [[ -n "$old" && -n "$new" ]] || die "usage: topic rename \"<old>\" \"<new>\" [--dry-run]"
  [[ "$old" != "$new" ]] || die "rename: the names are identical"

  local old_dir new_dir
  old_dir="$(topic_dir "$old")"; new_dir="$(topic_dir "$new")"
  [[ -f "$old_dir/topic.json" ]] || die "no such topic in this profile: \"$old\""
  [[ "$old_dir" == "$new_dir" || ! -e "$new_dir" ]] ||
    die "rename: \"$new\" already exists in this profile ($new_dir)"

  local self; self="$(cmd_whoami 2>/dev/null)" || self=""
  [[ -z "$self" || "$old" != "$self" ]] ||
    die "rename: \"$old\" is the session running this command — run it from another session"

  # Same reasoning as move: an adopted session runs outside tmux and cannot be stopped
  # by us, so its transcript must not be edited underneath it.
  if [[ "$(reg_read "$old" state)" == "adopted" ]]; then
    local apid asid live
    apid="$(reg_read "$old" adoptedPid)"; asid="$(reg_read "$old" sessionId)"
    live="$(live_sessions || true)"
    [[ -n "$apid" && "$live" == *"$apid	$asid	"* ]] &&
      die "rename: \"$old\" is adopted and still running as pid $apid — exit it first"
  fi

  local sid tr was_up=0
  sid="$(reg_read "$old" sessionId)"
  tr="$(transcript_of "$sid")"
  is_up "$old" && was_up=1

  echo "Renaming \"$old\" -> \"$new\""
  echo "  registry:  $old_dir -> $new_dir"
  echo "  tmux:      $(tmux_name "$old") -> $(tmux_name "$new")"
  [[ -n "$tr" ]] && echo "  transcript: re-titled, and its Remote Control bridge re-minted"
  echo "  NOTE: the Claude UI conversation restarts; the old entry is orphaned there."
  [[ $was_up -eq 1 ]] && echo "  it is UP: will be put down and brought back up under the new name"
  if [[ $dry -eq 1 ]]; then echo; echo "Dry run — nothing changed."; return 0; fi

  [[ $was_up -eq 1 ]] && { cmd_down "$old" | sed 's/^/  /'; [[ -n "$tr" ]] && settle "$tr"; }

  if [[ "$old_dir" != "$new_dir" ]]; then mkdir -p "$(dirname "$new_dir")"; mv "$old_dir" "$new_dir"; fi
  reg_write "$new" name "$new" renamedFrom "$old" renamedAt "$(now_iso)"

  if [[ -n "$tr" ]]; then
    # Re-mint the bridge so --remote-control re-registers under the new name...
    drop_bridge_records "$tr" "$new_dir/backups" >/dev/null
    # ...and re-title the transcript, so `adopt` can find it by the new name later.
    # A rename appends a record rather than rewriting: last one wins.
    python3 -c '
import json,sys
f,title,sid=sys.argv[1],sys.argv[2],sys.argv[3]
with open(f,"a") as fh:
    fh.write(json.dumps({"type":"custom-title","customTitle":title,"sessionId":sid})+"\n")' \
      "$tr" "$new" "$sid"
  fi

  # Lineage recorded by `fork` points at names; leave no dangling references.
  local d n changed
  for d in "$TOPICS_ROOT"/*/; do
    [[ -f "$d/topic.json" ]] || continue
    changed="$(python3 -c '
import json,os,sys
f,old,new=sys.argv[1],sys.argv[2],sys.argv[3]
try: d=json.load(open(f))
except Exception: sys.exit(0)
hit=False
if d.get("forkedFrom")==old: d["forkedFrom"]=new; hit=True
forks=d.get("forks") or []
if old in forks:
    d["forks"]=[new if x==old else x for x in forks]; hit=True
if hit:
    tmp=f+".tmp"; json.dump(d,open(tmp,"w"),indent=2); os.replace(tmp,f)
    print(d.get("name",""))' "$d/topic.json" "$old" "$new")"
    [[ -n "$changed" ]] && echo "  updated lineage in \"$changed\""
  done

  if [[ $was_up -eq 1 ]]; then
    cmd_up "$new" | sed 's/^/  /'
    echo ""
    echo "Renamed and running as \"$new\"."
  else
    echo ""
    echo "Renamed. It is down; \`topic up \"$new\"\` starts it under the new name."
  fi
}

cmd_ensure_dispatcher() {
  if is_up "$DISPATCHER_NAME"; then
    echo "\"$DISPATCHER_NAME\" is up."
    return 0
  fi
  local dir; dir="$(reg_read "$DISPATCHER_NAME" dir)"; [[ -n "$dir" ]] || dir="$HOME"
  echo "\"$DISPATCHER_NAME\" is down — starting it."
  cmd_up "$DISPATCHER_NAME" "$dir"
}

usage() {
  # Everything between the shebang and `set -euo` is the help text — no line
  # numbers to keep in sync as commands are added.
  sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'
}

case "${1:-}" in
  up)                shift; cmd_up "$@" ;;
  adopt)             shift; cmd_adopt "$@" ;;
  forget)            shift; cmd_forget "$@" ;;
  down-all)          shift; cmd_down_all "$@" ;;
  profiles)          shift; cmd_profiles "$@" ;;
  move)              shift; cmd_move "$@" ;;
  rebridge)          shift; cmd_rebridge "$@" ;;
  rename)            shift; cmd_rename "$@" ;;
  prune)             shift; cmd_prune "$@" ;;
  down)              shift; cmd_down "$@" ;;
  list|ls)           shift; cmd_list "$@" ;;
  status)            shift; cmd_status "$@" ;;
  fork-path)         shift; cmd_fork_path "$@" ;;
  fork)              shift; cmd_fork "$@" ;;
  whoami)            shift; cmd_whoami "$@" ;;
  handoff-path)      shift; cmd_handoff_path "$@" ;;
  handoff-swap)      shift; cmd_handoff_swap "$@" ;;
  ensure-dispatcher) shift; cmd_ensure_dispatcher "$@" ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $1 (try: topic --help)" ;;
esac
