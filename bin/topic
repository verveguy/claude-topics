#!/usr/bin/env bash
# topic — pick up / put down / hand off long-running Claude Code "topics".
#
# A TOPIC is a stable name ("Fantasy Economics") that outlives any single Claude
# session. The session underneath gets recycled; the topic name does not. That is
# what makes hand-off possible.
#
#   topic up   "<name>" [dir]   Pick up: resume the topic's session, or start one.
#                               --seed-from <file> starts a NEW topic from a brief.
#   topic down "<name>"         Put down: terminate the session, stay resumable.
#   topic list                  Show every topic and whether it is up or down.
#   topic status "<name>"       Detail for one topic.
#   topic forget "<name>"       Stop tracking a topic (keeps handoff docs; --purge
#                               removes them). The session itself is untouched.
#   topic prune                 Show topics that are truly dead — down, with no
#                               transcript left to resume. --yes removes them.
#   topic adopt "<name>"        Track a session topic did not launch, by reading
#                               ~/.claude/sessions/<pid>.json. --pid / --dir
#                               disambiguate; --probe <token> handles a session
#                               with no live record.
#
#   topic handoff-path "<name>" Print where the handoff doc must be written.
#   topic handoff-swap "<name>" Retire the old session, start a fresh one seeded
#                               with the handoff doc, same topic name.
#
#   topic ensure-dispatcher     Start the Dispatcher topic if it is not up.
#                               (Run by launchd at login and every 5 minutes.)
#
# Each topic is backed by a stable session UUID, so `up` is a lossless --resume.
# Every session is started with BOTH --remote-control "<name>" and --name "<name>".
# Both are required and they do different jobs:
#   --remote-control  makes the session reachable from claude.ai / your phone
#   --name            sets the display name other Claude sessions see in
#                     ListAgents (without it a local session advertises itself
#                     as an auto-derived "<dir>-<hash>" and is unaddressable
#                     by topic name — verified 2026-08-08)
#
# Singleton: at most one live session per topic, enforced by an exact-match tmux
# check plus an atomic lock. Starting a topic that is already up is a no-op.
set -euo pipefail

TOPICS_ROOT="${CLAUDE_TOPICS_ROOT:-$HOME/.claude/topics}"
DISPATCHER_NAME="${CLAUDE_DISPATCHER_NAME:-Dispatcher}"

# launchd gives us a minimal PATH; make sure the tools we need are findable.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

die() { echo "topic: $*" >&2; exit 1; }

command -v tmux   >/dev/null || die "tmux not found on PATH"
command -v claude >/dev/null || die "claude not found on PATH"
command -v python3 >/dev/null || die "python3 not found on PATH"

# ---------------------------------------------------------------- names & paths

# "Fantasy Economics" -> "fantasy-economics" (registry directory name)
slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'
}

# tmux forbids ':' and '.' in session names; the display name keeps them.
tmux_name() { printf '%s' "$1" | tr ':.' '--'; }

topic_dir()  { printf '%s/%s' "$TOPICS_ROOT" "$(slugify "$1")"; }
topic_json() { printf '%s/topic.json' "$(topic_dir "$1")"; }

# ---------------------------------------------------------------- registry (JSON)

reg_read() {  # reg_read <name> <key> -> value or ""
  local f; f="$(topic_json "$1")"
  [[ -f "$f" ]] || { printf ''; return 0; }
  python3 -c '
import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: d={}
v=d.get(sys.argv[2],"")
print(v if v is not None else "")' "$f" "$2"
}

reg_write() {  # reg_write <name> <k> <v> [<k> <v> ...]
  local name="$1"; shift
  local f; f="$(topic_json "$name")"
  mkdir -p "$(dirname "$f")"
  python3 -c '
import json,os,sys
f=sys.argv[1]
try: d=json.load(open(f))
except Exception: d={}
kv=sys.argv[2:]
for i in range(0,len(kv),2): d[kv[i]]=kv[i+1]
tmp=f+".tmp"
json.dump(d,open(tmp,"w"),indent=2)
os.replace(tmp,f)' "$f" "$@"
}

reg_push_history() {  # reg_push_history <name> <sessionId> <handoffDoc>
  local f; f="$(topic_json "$1")"
  python3 -c '
import json,os,sys,datetime
f,sid,doc=sys.argv[1],sys.argv[2],sys.argv[3]
try: d=json.load(open(f))
except Exception: d={}
d.setdefault("history",[]).append({
  "sessionId": sid, "handoffDoc": doc,
  "retiredAt": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
})
tmp=f+".tmp"; json.dump(d,open(tmp,"w"),indent=2); os.replace(tmp,f)' "$f" "$2" "$3"
}

now_iso() { date +%Y-%m-%dT%H:%M:%S%z; }

# ---------------------------------------------------------------- liveness

is_up() { tmux has-session -t "=$(tmux_name "$1")" 2>/dev/null; }

# Atomic per-topic lock so two callers can't race a topic up at once.
lock_acquire() {
  local d="$TOPICS_ROOT/.locks"; mkdir -p "$d"
  LOCK_PATH="$d/$(slugify "$1").lock"
  if ! mkdir "$LOCK_PATH" 2>/dev/null; then
    # Stale lock older than 5 minutes is reclaimed.
    if [[ -n "$(find "$LOCK_PATH" -maxdepth 0 -mmin +5 2>/dev/null)" ]]; then
      rmdir "$LOCK_PATH" 2>/dev/null || true
      mkdir "$LOCK_PATH" 2>/dev/null || die "could not acquire lock for \"$1\""
    else
      die "\"$1\" is being started by another process (lock held)"
    fi
  fi
  trap 'rmdir "$LOCK_PATH" 2>/dev/null || true' EXIT
}

# ---------------------------------------------------------------- launching

# launch_session <display-name> <dir> <claude-args...>
# Creates a detached tmux session and sends the claude command into it.
# send-keys (not `tmux new -d claude`) so the shell survives claude exiting.
launch_session() {
  local name="$1" dir="$2"; shift 2
  local tn; tn="$(tmux_name "$name")"

  mkdir -p "$dir"; dir="$(cd "$dir" && pwd)"

  local cmd="claude"
  local a; for a in "$@"; do cmd+=" $(printf '%q' "$a")"; done

  tmux new-session -d -s "$tn" -c "$dir"
  tmux send-keys -t "$tn" "$cmd" Enter

  # Auto-accept the workspace trust prompt if it appears; otherwise wait for a
  # readiness marker. NOTE: this heuristic keys on Claude Code's startup text and
  # has needed updating before — suspect it first if startup detection misbehaves.
  printf "  starting"
  local i pane
  for i in $(seq 1 40); do
    pane="$(tmux capture-pane -t "$tn" -p 2>/dev/null || true)"
    if printf '%s' "$pane" | grep -q "trust this folder"; then
      sleep 0.3; tmux send-keys -t "$tn" Enter; printf " (trust accepted)"; break
    fi
    if printf '%s' "$pane" | grep -qiE "Welcome back|remote-control is active"; then
      break
    fi
    sleep 0.5; printf "."
  done
  echo
}

# Gracefully stop the claude process in a topic's tmux session, then kill it.
stop_session() {
  local tn; tn="$(tmux_name "$1")"
  tmux has-session -t "=$tn" 2>/dev/null || return 0
  # Escape interrupts any in-flight turn; /exit quits Claude cleanly so the
  # transcript is flushed. Transcripts are written incrementally, so even a hard
  # kill stays resumable — this is just the tidy path.
  tmux send-keys -t "$tn" Escape 2>/dev/null || true
  sleep 0.4
  tmux send-keys -t "$tn" "/exit" Enter 2>/dev/null || true
  local i
  for i in $(seq 1 12); do
    tmux has-session -t "=$tn" 2>/dev/null || return 0
    if ! tmux list-panes -t "=$tn" -F '#{pane_current_command}' 2>/dev/null | grep -qi claude; then
      break
    fi
    sleep 0.5
  done
  tmux kill-session -t "=$tn" 2>/dev/null || true
}

new_uuid() { uuidgen | tr '[:upper:]' '[:lower:]'; }

# ---------------------------------------------------------------- commands

cmd_up() {
  local name="" dir="" claim=0 seed_from=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --claim) claim=1; shift ;;
      --seed-from) seed_from="$2"; shift 2 ;;
      *) if [[ -z "$name" ]]; then name="$1"; else dir="$1"; fi; shift ;;
    esac
  done
  [[ -n "$name" ]] || die "usage: topic up \"<name>\" [dir] [--claim] [--seed-from <file>]"
  if [[ -n "$seed_from" ]]; then
    [[ -f "$seed_from" ]] || die "--seed-from: no such file: $seed_from"
    [[ -s "$seed_from" ]] || die "--seed-from: file is empty: $seed_from"
    seed_from="$(cd "$(dirname "$seed_from")" && pwd)/$(basename "$seed_from")"
  fi

  lock_acquire "$name"

  # An adopted topic still has its ORIGINAL process running outside tmux. Starting
  # here would --resume the same session UUID in a second process: two writers on
  # one transcript, which corrupts it.
  #
  # When adoption went through ~/.claude/sessions we know the original pid, so the
  # hazard IS detectable — and --claim must not be allowed to override a process we
  # can still see. Match on sessionId too, in case the pid has been recycled.
  local adopted_pid=""
  if [[ "$(reg_read "$name" state)" == "adopted" ]]; then
    adopted_pid="$(reg_read "$name" adoptedPid)"
    if [[ -n "$adopted_pid" ]]; then
      local asid live
      asid="$(reg_read "$name" sessionId)"
      live="$(live_sessions || true)"
      if [[ "$live" == *"$adopted_pid	$asid	"* ]]; then
        echo "\"$name\" is still running as pid $adopted_pid, outside tmux." >&2
        echo "  Resuming session ${asid:0:8}… in a second process would corrupt its" >&2
        echo "  transcript. Exit that session (/exit in its window), then re-run." >&2
        die "refusing to start while the original process is alive"
      fi
      # Positively verified gone — no need to make the caller assert it.
      claim=1
    fi
  fi

  # No pid on record (probe-adopted, or an older registry entry): we cannot see the
  # original process, so make the caller assert it is gone.
  if [[ "$(reg_read "$name" state)" == "adopted" && $claim -eq 0 ]]; then
    echo "\"$name\" was adopted but not yet claimed." >&2
    echo "" >&2
    echo "  Its original session is running OUTSIDE tmux. Starting it here would" >&2
    echo "  resume the same session UUID in a second process and corrupt the" >&2
    echo "  transcript." >&2
    echo "" >&2
    echo "  1. Exit the original session (/exit in its window)." >&2
    echo "  2. topic up \"$name\" --claim" >&2
    die "refusing to start until the original session has exited"
  fi

  if is_up "$name"; then
    echo "\"$name\" is already up."
    echo "  attach: tmux attach -t \"$(tmux_name "$name")\""
    return 0
  fi

  local recorded_dir sid
  recorded_dir="$(reg_read "$name" dir)"
  [[ -z "$dir" ]] && dir="${recorded_dir:-$PWD}"
  sid="$(reg_read "$name" sessionId)"

  if [[ -n "$sid" ]]; then
    [[ -n "$seed_from" ]] &&
      echo "note: --seed-from ignored; \"$name\" has an existing session to resume." >&2
    echo "Picking up \"$name\" (resuming session ${sid:0:8}…) in $dir"
    launch_session "$name" "$dir" --remote-control "$name" --name "$name" --resume "$sid"
  else
    sid="$(new_uuid)"
    echo "Starting \"$name\" (new session ${sid:0:8}…) in $dir"
    if [[ -n "$seed_from" ]]; then
      # Same seeding path handoff-swap uses, but for a brand-new topic: start a
      # topic from a brief (a handoff doc, an ideas/ note, an issue write-up).
      local seed="You are starting the topic \"$name\". Read the briefing document at $seed_from — it contains the context you need. Summarise briefly what you picked up, then continue from there."
      launch_session "$name" "$dir" --remote-control "$name" --name "$name" \
                     --session-id "$sid" "$seed"
      reg_write "$name" name "$name" generation "1" seededFrom "$seed_from"
    else
      launch_session "$name" "$dir" --remote-control "$name" --name "$name" --session-id "$sid"
      reg_write "$name" name "$name" generation "1"
    fi
  fi

  reg_write "$name" name "$name" dir "$dir" sessionId "$sid" \
            state "up" lastPickedUp "$(now_iso)"
  echo "\"$name\" is up. Remote Control name: \"$name\""
}

cmd_down() {
  local name="${1:?usage: topic down \"<name>\"}"
  if ! is_up "$name"; then
    # An adopted session runs outside tmux, so we cannot stop it for the user.
    # Say so plainly rather than reporting a false "already down".
    if [[ "$(reg_read "$name" state)" == "adopted" ]]; then
      echo "\"$name\" was adopted and is running OUTSIDE tmux — topic cannot stop it."
      echo "  Exit that session yourself (/exit in its window), then:"
      echo "    topic up \"$name\"   # relaunches it under topic management, resuming context"
      return 0
    fi
    echo "\"$name\" is already down."
    return 0
  fi
  echo "Putting down \"$name\"…"
  stop_session "$name"
  reg_write "$name" state "down" lastPutDown "$(now_iso)"
  echo "\"$name\" is down. Session retained — \`topic up \"$name\"\` resumes it."
}

cmd_handoff_path() {
  local name="${1:?usage: topic handoff-path \"<name>\"}"
  local d; d="$(topic_dir "$name")/handoffs"
  mkdir -p "$d"
  printf '%s/%s.md\n' "$d" "$(date +%Y%m%d-%H%M%S)"
}

cmd_handoff_swap() {
  local name="" doc="" focus=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --focus) focus="$2"; shift 2 ;;
      *) if [[ -z "$name" ]]; then name="$1"; else doc="$1"; fi; shift ;;
    esac
  done
  [[ -n "$name" ]] || die "usage: topic handoff-swap \"<name>\" [handoff-doc] [--focus \"<what to pick up>\"]"

  if [[ -z "$doc" ]]; then
    doc="$(ls -1t "$(topic_dir "$name")/handoffs"/*.md 2>/dev/null | head -1 || true)"
  fi
  [[ -n "$doc" && -f "$doc" ]] || die "no handoff doc found for \"$name\" — write one first (topic handoff-path \"$name\")"
  [[ -s "$doc" ]] || die "handoff doc $doc is empty — refusing to swap"

  local old_sid dir gen
  old_sid="$(reg_read "$name" sessionId)"
  dir="$(reg_read "$name" dir)"; [[ -n "$dir" ]] || dir="$PWD"
  gen="$(reg_read "$name" generation)"; [[ -n "$gen" ]] || gen=1

  echo "Handing off \"$name\" (generation $gen -> $((gen+1)))"
  echo "  handoff doc: $doc"

  # Retire the old session first so the topic stays a singleton.
  stop_session "$name"
  [[ -n "$old_sid" ]] && reg_push_history "$name" "$old_sid" "$doc"

  local new_sid; new_sid="$(new_uuid)"
  local seed="You are resuming the topic \"$name\" in a fresh session. Read the handoff document at $doc — it was written by your previous session on this topic and contains the salient context. Summarise briefly what you picked up, then continue from there."
  if [[ -n "$focus" ]]; then
    seed+=" The handoff is focused on: ${focus}. Start there. The doc also lists other open threads that were deliberately set aside — do not act on those unless asked, but do not treat them as finished either."
  fi

  launch_session "$name" "$dir" --remote-control "$name" --name "$name" --session-id "$new_sid" "$seed"

  reg_write "$name" name "$name" dir "$dir" sessionId "$new_sid" \
            state "up" generation "$((gen+1))" lastPickedUp "$(now_iso)" \
            lastHandoff "$doc"
  echo "\"$name\" is up on a fresh session (${new_sid:0:8}…). Old session archived in history."
}

# Unregister a topic. Handoff docs are KEPT by default — they are often the only
# surviving record of what a topic was about, and "stop tracking this" should not
# mean "destroy the history". --purge removes them too.
cmd_forget() {
  local name="" purge=0 dead=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --purge) purge=1; shift ;;
      --dead)  dead=1; shift ;;   # internal: set by `prune`, suppresses the
      *) name="$1"; shift ;;      # "still resumable" line for a dead session
    esac
  done
  [[ -n "$name" ]] || die "usage: topic forget \"<name>\" [--purge]"

  local d; d="$(topic_dir "$name")"
  [[ -f "$d/topic.json" ]] || die "no such topic: \"$name\""
  is_up "$name" && die "\"$name\" is still up — \`topic down \"$name\"\` first"
  [[ "$(reg_read "$name" state)" == "adopted" ]] &&
    echo "note: \"$name\" was adopted; its original session may still be running." >&2

  local sid n
  sid="$(reg_read "$name" sessionId)"
  # An absent handoffs dir makes the lister exit non-zero, and `pipefail` + `set -e`
  # would turn that into a silent abort BEFORE anything is deleted — `topic forget`
  # did exactly that for every topic with no handoff docs. The trailing `|| true`
  # is what actually fixes it; the count still comes through.
  n="$(find "$d/handoffs" -name '*.md' -type f 2>/dev/null | wc -l | tr -d ' ' || true)"
  [[ -n "$n" ]] || n=0

  if [[ $purge -eq 1 ]]; then
    rm -rf "$d"
    echo "Forgot \"$name\" and purged $n handoff doc(s)."
  else
    rm -f "$d/topic.json"
    rmdir "$d" 2>/dev/null || true   # succeeds only if nothing else remains
    echo "Forgot \"$name\"."
    [[ "$n" -gt 0 ]] && echo "  Kept $n handoff doc(s) in $d/handoffs/ (--purge to remove)."
  fi
  # The session itself is untouched and still resumable directly — unless `prune`
  # already established that its transcript is gone.
  [[ -n "$sid" && $dead -eq 0 ]] && echo "  Session $sid is untouched: claude --resume $sid"
  return 0
}

# Path to a session's transcript, or "" if it no longer exists. A topic whose
# transcript is gone cannot be --resume'd: it is dead, not merely put down.
transcript_of() {
  local uuid="$1"
  [[ -n "$uuid" ]] || { printf ''; return 0; }
  find "$HOME/.claude/projects" -name "$uuid.jsonl" -print -quit 2>/dev/null || printf ''
}

# Remove topics that are truly dead — down, and with no transcript left to resume.
# Dry-run by default: nothing is deleted until --yes.
#
#   topic prune [--yes] [--purge]
cmd_prune() {
  local yes=0 purge=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes|-y) yes=1; shift ;;
      --purge)  purge=1; shift ;;
      *) die "prune: unexpected argument: $1" ;;
    esac
  done

  mkdir -p "$TOPICS_ROOT"
  local dead=() d name sid
  for d in "$TOPICS_ROOT"/*/; do
    [[ -f "$d/topic.json" ]] || continue
    name="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("name",""))' "$d/topic.json")"
    [[ -n "$name" ]] || continue
    is_up "$name" && continue
    sid="$(reg_read "$name" sessionId)"
    # No sessionId at all also counts as dead: nothing to resume.
    [[ -z "$sid" || -z "$(transcript_of "$sid")" ]] && dead+=("$name")
  done

  if [[ ${#dead[@]} -eq 0 ]]; then
    echo "Nothing to prune — every down topic still has a resumable transcript."
    return 0
  fi

  echo "Dead topics (down, transcript gone — not resumable):"
  for name in "${dead[@]}"; do
    sid="$(reg_read "$name" sessionId)"
    printf '  %-30s %s\n' "$name" "${sid:-<no session>}"
  done

  if [[ $yes -eq 0 ]]; then
    echo ""
    local extra=""; [[ $purge -eq 1 ]] && extra=" --purge"
    echo "Dry run. To remove: topic prune --yes$extra"
    echo "  (handoff docs are kept unless --purge)"
    return 0
  fi

  echo ""
  for name in "${dead[@]}"; do
    if [[ $purge -eq 1 ]]; then cmd_forget "$name" --dead --purge; else cmd_forget "$name" --dead; fi
  done
}

# Every LIVE session writes ~/.claude/sessions/<pid>.json holding the authoritative
# name -> sessionId -> cwd mapping. Records are NOT removed when a session exits,
# so liveness must be re-checked against the pid.
#
# Emits one TSV line per live session: pid \t sessionId \t cwd \t name
live_sessions() {
  python3 -c '
import glob, json, os, sys
for f in sorted(glob.glob(os.path.expanduser("~/.claude/sessions/*.json"))):
    try: d = json.load(open(f))
    except Exception: continue
    pid, sid = d.get("pid"), d.get("sessionId")
    if not pid or not sid: continue
    try: os.kill(int(pid), 0)          # stale record from an exited session
    except OSError: continue
    print("\t".join(str(x) for x in (pid, sid, d.get("cwd",""), d.get("name",""))))'
}

# Adopt an already-running session that topic did not launch.
#
# Preferred path: read ~/.claude/sessions/<pid>.json, which already knows the
# session UUID — no probe, no round trip. `topic adopt "<name>"` narrows the live
# sessions by --pid, then --dir, then by a name equal to the topic name, and
# adopts if exactly one candidate survives.
#
# Fallback path (--probe): for a session with no live record — it exited, or its
# record is unreadable. A running session does not hold its transcript open, so
# instead the caller sends the target a unique token via SendMessage and names it
# here; we find which transcript the token landed in. The caller's OWN transcript
# also contains the token (it sent it), hence --exclude.
#
#   topic adopt "<name>" [--pid <pid>] [--dir <dir>] [--exclude <uuid>]
#   topic adopt "<name>" --probe <token> [--dir <dir>] [--exclude <uuid>]
cmd_adopt() {
  local name="${1:?usage: topic adopt \"<name>\" [--pid <pid>] [--dir <dir>] | --probe <token>}"; shift
  local probe="" dir="" exclude="" pid=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --probe)      probe="$2"; shift 2 ;;
      --dir)        dir="$2"; shift 2 ;;
      --pid)        pid="$2"; shift 2 ;;
      --exclude)    exclude="$2"; shift 2 ;;
      --session-id) known_uuid="$2"; shift 2 ;;
      *) die "adopt: unexpected argument: $1" ;;
    esac
  done

  # A session that already knows its own UUID (e.g. adopting itself) can skip the
  # probe entirely.
  if [[ -n "${known_uuid:-}" ]]; then
    local kdir="${dir:-$PWD}"
    reg_write "$name" name "$name" dir "$kdir" sessionId "$known_uuid" \
              generation "1" state "adopted" adoptedAt "$(now_iso)"
    echo "Adopted \"$name\" -> session ${known_uuid:0:8}… (dir: $kdir)"
    echo "  Running OUTSIDE topic management. Exit it, then:"
    echo "    topic up \"$name\" --claim"
    return 0
  fi

  # ---- preferred path: the live session already published its own UUID --------
  if [[ -z "$probe" ]]; then
    local all=() rows=() row
    while IFS= read -r row; do
      [[ -n "$exclude" && "$row" == *"	$exclude	"* ]] && continue
      all+=("$row")
    done < <(live_sessions)

    [[ ${#all[@]} -gt 0 ]] ||
      die "adopt: no live sessions found in ~/.claude/sessions — if the target has exited, use --probe"

    # Narrow progressively; keep the last filter that left at least one candidate.
    rows=("${all[@]}")
    local filtered=()
    _narrow() {  # _narrow <awk-field> <value>
      filtered=()
      for row in "${rows[@]}"; do
        [[ "$(printf '%s' "$row" | cut -f"$1")" == "$2" ]] && filtered+=("$row")
      done
      # A filter that matches nothing is ignored, not fatal — keep the wider set
      # and let the caller disambiguate. Must return 0 or `set -e` kills us.
      [[ ${#filtered[@]} -gt 0 ]] && rows=("${filtered[@]}")
      return 0
    }
    # --pid is an explicit assertion: if it matches no live session, say so rather
    # than quietly adopting something else.
    if [[ -n "$pid" ]]; then
      _narrow 1 "$pid"
      [[ "$(printf '%s' "${rows[0]}" | cut -f1)" == "$pid" ]] ||
        die "adopt: no live session with pid $pid (see ~/.claude/sessions)"
    fi
    [[ -n "$dir" ]] && _narrow 3 "$dir"
    _narrow 4 "$name"

    if [[ ${#rows[@]} -ne 1 ]]; then
      echo "adopt: ${#rows[@]} live sessions match — disambiguate with --pid (or --dir):" >&2
      for row in "${rows[@]}"; do
        printf '  --pid %-7s %-40s %s\n' \
          "$(printf '%s' "$row" | cut -f1)" \
          "$(printf '%s' "$row" | cut -f4)" \
          "$(printf '%s' "$row" | cut -f3)" >&2
      done
      die "expected exactly one match"
    fi

    local uuid; uuid="$(printf '%s' "${rows[0]}" | cut -f2)"
    local spid; spid="$(printf '%s' "${rows[0]}" | cut -f1)"
    local sdir; sdir="$(printf '%s' "${rows[0]}" | cut -f3)"
    local sname; sname="$(printf '%s' "${rows[0]}" | cut -f4)"
    [[ -n "$dir" ]] || dir="${sdir:-$HOME}"

    reg_write "$name" name "$name" dir "$dir" sessionId "$uuid" \
              generation "1" state "adopted" adoptedAt "$(now_iso)" adoptedPid "$spid"
    echo "Adopted \"$name\" -> session ${uuid:0:8}… (pid $spid, advertised as \"${sname:-?}\", dir: $dir)"
    echo "  Still running OUTSIDE topic management as pid $spid."
    echo "  Exit that session, then: topic up \"$name\""
    echo "  (no --claim needed — the pid is on record, so topic checks it for you)"
    return 0
  fi

  local projects="$HOME/.claude/projects"
  local hits=() f uuid
  while IFS= read -r f; do
    uuid="$(basename "$f" .jsonl)"
    [[ -n "$exclude" && "$uuid" == "$exclude" ]] && continue
    hits+=("$f")
  done < <(grep -rl -- "$probe" "$projects" 2>/dev/null | grep '\.jsonl$' || true)

  case "${#hits[@]}" in
    0) die "adopt: probe token \"$probe\" not found in any transcript — did the target session receive it?" ;;
    1) : ;;
    *) echo "adopt: probe matched ${#hits[@]} transcripts — cannot disambiguate:" >&2
       printf '  %s\n' "${hits[@]}" >&2
       die "re-run with --exclude <your-own-session-uuid>" ;;
  esac

  uuid="$(basename "${hits[0]}" .jsonl)"

  # Derive the working directory from the transcript's project slug if not given.
  if [[ -z "$dir" ]]; then
    local slug; slug="$(basename "$(dirname "${hits[0]}")")"
    dir="$(printf '%s' "$slug" | sed 's|^-|/|; s|-|/|g')"
    [[ -d "$dir" ]] || dir="$HOME"
  fi

  reg_write "$name" name "$name" dir "$dir" sessionId "$uuid" \
            generation "1" state "adopted" adoptedAt "$(now_iso)"
  echo "Adopted \"$name\" -> session ${uuid:0:8}… (dir: $dir)"
  echo "  It is still running OUTSIDE topic management (no tmux, no --name)."
  echo "  \`topic down \"$name\"\` then \`topic up \"$name\"\` brings it fully under management."
}

cmd_status() {
  local name="${1:?usage: topic status \"<name>\"}"
  local f; f="$(topic_json "$name")"
  [[ -f "$f" ]] || die "no such topic: \"$name\""
  local state; if is_up "$name"; then state="UP"; else state="down"; fi
  echo "$name  [$state]"
  python3 -c '
import json,sys
d=json.load(open(sys.argv[1]))
for k in ("dir","sessionId","generation","lastPickedUp","lastPutDown","lastHandoff"):
    if d.get(k): print(f"  {k}: {d[k]}")
h=d.get("history") or []
if h: print(f"  retired sessions: {len(h)}")' "$f"
}

cmd_list() {
  mkdir -p "$TOPICS_ROOT"
  local found=0 d name state
  for d in "$TOPICS_ROOT"/*/; do
    [[ -f "$d/topic.json" ]] || continue
    found=1
    name="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("name",""))' "$d/topic.json")"
    [[ -n "$name" ]] || continue
    # An adopted topic is running outside tmux, so is_up() cannot see it.
    # Report that honestly rather than calling a live session "down".
    if is_up "$name"; then
      state="UP    "
    elif [[ "$(reg_read "$name" state)" == "adopted" ]]; then
      state="ADOPTED"
    else
      state="down  "
    fi
    printf '  %-7s %s\n' "$state" "$name"
  done
  [[ $found -eq 1 ]] || echo "  (no topics yet — \`topic up \"<name>\" [dir]\` creates one)"
}

cmd_ensure_dispatcher() {
  if is_up "$DISPATCHER_NAME"; then
    echo "\"$DISPATCHER_NAME\" is up."
    return 0
  fi
  local dir; dir="$(reg_read "$DISPATCHER_NAME" dir)"; [[ -n "$dir" ]] || dir="$HOME"
  echo "\"$DISPATCHER_NAME\" is down — starting it."
  cmd_up "$DISPATCHER_NAME" "$dir"
}

usage() {
  sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'
}

case "${1:-}" in
  up)                shift; cmd_up "$@" ;;
  adopt)             shift; cmd_adopt "$@" ;;
  forget)            shift; cmd_forget "$@" ;;
  prune)             shift; cmd_prune "$@" ;;
  down)              shift; cmd_down "$@" ;;
  list|ls)           shift; cmd_list "$@" ;;
  status)            shift; cmd_status "$@" ;;
  handoff-path)      shift; cmd_handoff_path "$@" ;;
  handoff-swap)      shift; cmd_handoff_swap "$@" ;;
  ensure-dispatcher) shift; cmd_ensure_dispatcher "$@" ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $1 (try: topic --help)" ;;
esac
